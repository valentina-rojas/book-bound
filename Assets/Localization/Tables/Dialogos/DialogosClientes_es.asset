%YAML 1.1
%TAG !u! tag:unity3d.com,2011:
--- !u!114 &11400000
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 0}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: e9620f8c34305754d8cc9a7e49e852d9, type: 3}
  m_Name: DialogosClientes_es
  m_EditorClassIdentifier: 
  m_LocaleId:
    m_Code: es
  m_SharedData: {fileID: 11400000, guid: 398c04003a7316346af2890274873762, type: 2}
  m_Metadata:
    m_Items: []
  m_TableData:
  - m_Id: 521054887936
    m_Localized: Escucha...
    m_Metadata:
      m_Items: []
  - m_Id: 521054887937
    m_Localized: "Necesito ese Breviario de Elixires y Conjuros L\xEDquidos..."
    m_Metadata:
      m_Items: []
  - m_Id: 521054887938
    m_Localized: URGENTE!!
    m_Metadata:
      m_Items: []
  - m_Id: 521054887939
    m_Localized: "Mi vecino lleva semanas molest\xE1ndome con sus gallinas infernales..."
    m_Metadata:
      m_Items: []
  - m_Id: 521054887940
    m_Localized: y, francamente, creo que ya es hora de convertirlo en un helecho.
    m_Metadata:
      m_Items: []
  - m_Id: 521054887941
    m_Localized: "\xBFLo tienes o no?"
    m_Metadata:
      m_Items: []
  - m_Id: 521054887942
    m_Localized: "\xA1Por el caldero de mi abuela!"
    m_Metadata:
      m_Items: []
  - m_Id: 521054887943
    m_Localized: "\xA1Este mismo!"
    m_Metadata:
      m_Items: []
  - m_Id: 521054887944
    m_Localized: "Voy a prepararle un guiso de venganza a ese infeliz\u2026"
    m_Metadata:
      m_Items: []
  - m_Id: 521054887945
    m_Localized: Te debo una.
    m_Metadata:
      m_Items: []
  - m_Id: 521054887946
    m_Localized: "Si un d\xEDa quieres deshacerte de alg\xFAn vecino, p\xE1sate por
      mi caba\xF1a"
    m_Metadata:
      m_Items: []
  - m_Id: 521054887947
    m_Localized: "\xBFQu\xE9 es esto?"
    m_Metadata:
      m_Items: []
  - m_Id: 521054887948
    m_Localized: "\xA1No, no, no! Yo quiero hongos."
    m_Metadata:
      m_Items: []
  - m_Id: 521054887949
    m_Localized: Esto no me sirve
    m_Metadata:
      m_Items: []
  - m_Id: 521054887951
    m_Localized: Vengo a devolver esto
    m_Metadata:
      m_Items: []
  - m_Id: 521054887952
    m_Localized: "Fue muy \xFAtil, volver\xE9 otra vez"
    m_Metadata:
      m_Items: []
  - m_Id: 521054887953
    m_Localized: Esta vez vine a dar y no pedir
    m_Metadata:
      m_Items: []
  - m_Id: 521054887954
    m_Localized: "Quiz\xE1 le des m\xE1s utilidad que yo"
    m_Metadata:
      m_Items: []
  - m_Id: 521054887955
    m_Localized: "\xA1Eh, hola!"
    m_Metadata:
      m_Items: []
  - m_Id: 521054887956
    m_Localized: "Perd\xF3n por llegar as\xED, pero necesito tu ayuda urgente."
    m_Metadata:
      m_Items: []
  - m_Id: 521054887957
    m_Localized: "Estaba practicando una encuadernaci\xF3n antigua y\u2026"
    m_Metadata:
      m_Items: []
  - m_Id: 521054887958
    m_Localized: "bueno\u2026"
    m_Metadata:
      m_Items: []
  - m_Id: 521054887959
    m_Localized: "se me desarm\xF3 el libro entero."
    m_Metadata:
      m_Items: []
  - m_Id: 521054887960
    m_Localized: "Las p\xE1ginas salieron volando por todos lados."
    m_Metadata:
      m_Items: []
  - m_Id: 521054887961
    m_Localized: Si mi maestro se entera, me va a mandar a limpiar estantes por una
      semana.
    m_Metadata:
      m_Items: []
  - m_Id: 521054887962
    m_Localized: "\xBFPodr\xEDas ayudarme a ordenarlas de nuevo?"
    m_Metadata:
      m_Items: []
  - m_Id: 521054887963
    m_Localized: "\xA1Lo lograste!"
    m_Metadata:
      m_Items: []
  - m_Id: 521054887964
    m_Localized: "No puedo creer lo bien que qued\xF3."
    m_Metadata:
      m_Items: []
  - m_Id: 521054887965
    m_Localized: "Hasta parece que nunca se desarm\xF3."
    m_Metadata:
      m_Items: []
  - m_Id: 521054887966
    m_Localized: "Mi maestro no se enterar\xE1 de nada\u2026"
    m_Metadata:
      m_Items: []
  - m_Id: 521054887967
    m_Localized: y yo voy a poder dormir tranquilo esta noche.
    m_Metadata:
      m_Items: []
  - m_Id: 521054887968
    m_Localized: Buen dia...
    m_Metadata:
      m_Items: []
  - m_Id: 521054887969
    m_Localized: "necesito ese libro\u2026"
    m_Metadata:
      m_Items: []
  - m_Id: 521054887970
    m_Localized: uno lleno de cuentos para asustar a los mocosos que se esconden
      bajo mi cama.
    m_Metadata:
      m_Items: []
  - m_Id: 521054887971
    m_Localized: No recuerdo el nombre...
    m_Metadata:
      m_Items: []
  - m_Id: 521054887972
    m_Localized: "Pero tenia historias de manos fr\xEDas, risas raras en los armarios..."
    m_Metadata:
      m_Items: []
  - m_Id: 521054887973
    m_Localized: "y cosas que se asoman desde debajo del colch\xF3n."
    m_Metadata:
      m_Items: []
  - m_Id: 521054887974
    m_Localized: "\xA1Justo lo que necesitaba!"
    m_Metadata:
      m_Items: []
  - m_Id: 521054887975
    m_Localized: "Jejeje\u2026"
    m_Metadata:
      m_Items: []
  - m_Id: 521054887976
    m_Localized: "perfecto para asustar a esos mocosos et\xE9reos que me chillan
      en los tobillos a medianoche."
    m_Metadata:
      m_Items: []
  - m_Id: 521054887977
    m_Localized: "Si sobrevivo hasta ma\xF1ana, paso a contarte c\xF3mo fue."
    m_Metadata:
      m_Items: []
  - m_Id: 521054887978
    m_Localized: "A ver\u2026"
    m_Metadata:
      m_Items: []
  - m_Id: 521054887979
    m_Localized: "\xBFy esto qu\xE9 es?..."
    m_Metadata:
      m_Items: []
  - m_Id: 521059082240
    m_Localized: como me dejen un zapato bajo la cama esta noche, te maldigo las
      pantuflas.
    m_Metadata:
      m_Items: []
  - m_Id: 521059082241
    m_Localized: Buen dia...
    m_Metadata:
      m_Items: []
  - m_Id: 521059082242
    m_Localized: Te devuelvo esto
    m_Metadata:
      m_Items: []
  - m_Id: 521059082243
    m_Localized: Hubieras visto como corrieron esos mocosos
    m_Metadata:
      m_Items: []
  - m_Id: 521059082244
    m_Localized: Fue muy divertido
    m_Metadata:
      m_Items: []
  - m_Id: 521059082245
    m_Localized: "Hola\u2026"
    m_Metadata:
      m_Items: []
  - m_Id: 521059082246
    m_Localized: "\xBFtienes un momento?"
    m_Metadata:
      m_Items: []
  - m_Id: 521059082247
    m_Localized: Necesito tu ayuda con algo.
    m_Metadata:
      m_Items: []
  - m_Id: 521059082248
    m_Localized: "He escrito un libro con todos mis viajes y descubrimientos, pero\u2026"
    m_Metadata:
      m_Items: []
  - m_Id: 521059082249
    m_Localized: no soy muy buena dibujando portadas.
    m_Metadata:
      m_Items: []
  - m_Id: 521059082250
    m_Localized: "Quer\xEDa algo que tenga un mapa, una br\xFAjula..."
    m_Metadata:
      m_Items: []
  - m_Id: 521059082251
    m_Localized: "tal vez un drag\xF3n peque\xF1ito escondido entre las monta\xF1as\u2026"
    m_Metadata:
      m_Items: []
  - m_Id: 521059082252
    m_Localized: "\xBFt\xFA podr\xEDas hacerlo?"
    m_Metadata:
      m_Items: []
  - m_Id: 521059082253
    m_Localized: "No tiene que ser perfecto, solo\u2026"
    m_Metadata:
      m_Items: []
  - m_Id: 521059082254
    m_Localized: "algo que haga sonre\xEDr cuando lo vea en la estanter\xEDa."
    m_Metadata:
      m_Items: []
  - m_Id: 521059082255
    m_Localized: "Est\xE1\u2026 \xA1precioso!"
    m_Metadata:
      m_Items: []
  - m_Id: 521059082256
    m_Localized: "\xA1Este mismo!"
    m_Metadata:
      m_Items: []
  - m_Id: 521059082257
    m_Localized: "No sabes cu\xE1nto significa para m\xED."
    m_Metadata:
      m_Items: []
  - m_Id: 521059082258
    m_Localized: "Cada detalle\u2026 es justo lo que imaginaba"
    m_Metadata:
      m_Items: []
  - m_Id: 521059082259
    m_Localized: "Gracias\u2026 de verdad. \xA1Eres incre\xEDble!"
    m_Metadata:
      m_Items: []
  - m_Id: 521059082260
    m_Localized: "\xBFQu\xE9...?"
    m_Metadata:
      m_Items: []
  - m_Id: 521059082261
    m_Localized: Esto no es lo que me imaginaba...
    m_Metadata:
      m_Items: []
  - m_Id: 521059082262
    m_Localized: "Buenas\u2026"
    m_Metadata:
      m_Items: []
  - m_Id: 521059082263
    m_Localized: "o tal vez malas\u2026"
    m_Metadata:
      m_Items: []
  - m_Id: 521059082264
    m_Localized: "\xBFqu\xE9 hora es? Da igual."
    m_Metadata:
      m_Items: []
  - m_Id: 521059082265
    m_Localized: Busco La Dama de los Secretos Perdidos.
    m_Metadata:
      m_Items: []
  - m_Id: 521059082266
    m_Localized: "Y antes de que preguntes: s\xED, es para m\xED."
    m_Metadata:
      m_Items: []
  - m_Id: 521059082267
    m_Localized: "Y no, no pienso contarte para qu\xE9 lo quiero."
    m_Metadata:
      m_Items: []
  - m_Id: 521059082268
    m_Localized: "Hmm\u2026 s\xED, este es el que buscaba."
    m_Metadata:
      m_Items: []
  - m_Id: 521059082269
    m_Localized: Gracias...
    m_Metadata:
      m_Items: []
  - m_Id: 521059082270
    m_Localized: "\xBFQu\xE9 te hizo pensar que me interesar\xEDa un libro de esos?"
    m_Metadata:
      m_Items: []
  - m_Id: 521059082271
    m_Localized: Ugh... no importa.
    m_Metadata:
      m_Items: []
  - m_Id: 521059082272
    m_Localized: Traje esto de nuevo...
    m_Metadata:
      m_Items: []
  - m_Id: 521059082273
    m_Localized: Gracias...
    m_Metadata:
      m_Items: []
  - m_Id: 521059082274
    m_Localized: "Hmpf. As\xED que t\xFA eres el nuevo encargado..."
    m_Metadata:
      m_Items: []
  - m_Id: 521059082275
    m_Localized: "\xBFCu\xE1nto tiempo llevas aqu\xED? \xBFHoras? \xBFMinutos?"
    m_Metadata:
      m_Items: []
  - m_Id: 521059082276
    m_Localized: "Huele a incompetencia\u2026"
    m_Metadata:
      m_Items: []
  - m_Id: 521059082277
    m_Localized: "\xBFQu\xE9 te parece un peque\xF1o juego para poner a prueba tu...
      \"sabidur\xEDa\"?"
    m_Metadata:
      m_Items: []
  - m_Id: 521059082278
    m_Localized: "Prep\xE1rate. No aceptar\xE9 respuestas mediocres."
    m_Metadata:
      m_Items: []
  - m_Id: 521059082279
    m_Localized: "No est\xE1 mal\u2026 para alguien con tan poco potencial."
    m_Metadata:
      m_Items: []
  - m_Id: 521059082280
    m_Localized: Espero que esto no haya sido pura suerte.
    m_Metadata:
      m_Items: []
  - m_Id: 521059082281
    m_Localized: Me conformo... por ahora. No te acostumbres a los elogios.
    m_Metadata:
      m_Items: []
  - m_Id: 521059082282
    m_Localized: "No s\xE9 si re\xEDr o llorar."
    m_Metadata:
      m_Items: []
  - m_Id: 521059082283
    m_Localized: Si vas a ocupar este puesto, al menos finge saber lo que haces.
    m_Metadata:
      m_Items: []
  - m_Id: 521059082284
    m_Localized: Eso fue... doloroso. Para ambos.
    m_Metadata:
      m_Items: []
  - m_Id: 521059082285
    m_Localized: Mejor me largo. No puedo ver tanta mediocridad junta.
    m_Metadata:
      m_Items: []
  - m_Id: 521059082286
    m_Localized: "Este libro... no es un libro cualquiera, coraz\xF3n."
    m_Metadata:
      m_Items: []
  - m_Id: 521059082287
    m_Localized: Dentro guarda una receta muy antigua..
    m_Metadata:
      m_Items: []
  - m_Id: 521059082288
    m_Localized: "prohibida\u2026"
    m_Metadata:
      m_Items: []
  - m_Id: 521059082289
    m_Localized: "olvidada a prop\xF3sito por quienes tem\xEDan su poder."
    m_Metadata:
      m_Items: []
  - m_Id: 521059082290
    m_Localized: "Si cayera en manos equivocadas... podr\xEDa desatar un desastre.
      O algo a\xFAn peor."
    m_Metadata:
      m_Items: []
  - m_Id: 521059082291
    m_Localized: "Necesito encantarlo, sellarlo con un conjuro especial\u2026"
    m_Metadata:
      m_Items: []
  - m_Id: 521059082292
    m_Localized: "No es dif\xEDcil, solo debes agregarle las runas correctas en orden"
    m_Metadata:
      m_Items: []
  - m_Id: 521059082293
    m_Localized: "Lo har\xEDa yo pero ya me tiemblan las manos y se me dificulta"
    m_Metadata:
      m_Items: []
  - m_Id: 521059082294
    m_Localized: Las runas que debes usar son las de tierra, sombra y fuego, en ese
      orden
    m_Metadata:
      m_Items: []
  - m_Id: 521059082295
    m_Localized: "\xBFCrees que podr\xEDas ayudarme?"
    m_Metadata:
      m_Items: []
  - m_Id: 521059082296
    m_Localized: "\xA1Que maravilla!"
    m_Metadata:
      m_Items: []
  - m_Id: 521059082297
    m_Localized: "El libro est\xE1 sellado con un hechizo perfecto."
    m_Metadata:
      m_Items: []
  - m_Id: 521059082298
    m_Localized: "Conf\xEDo en que el conocimiento contenido aqu\xED permanecer\xE1
      a salvo... gracias a ti."
    m_Metadata:
      m_Items: []
  - m_Id: 521059082299
    m_Localized: Oh, cielos... algo ha salido mal.
    m_Metadata:
      m_Items: []
  - m_Id: 521059082300
    m_Localized: "Este no es el hechizo que quer\xEDa\u2026"
    m_Metadata:
      m_Items: []
  - m_Id: 521059082301
    m_Localized: Si alguien indeseado lo abre... no quiero ni imaginarlo.
    m_Metadata:
      m_Items: []
  - m_Id: 521059082302
    m_Localized: "Tendr\xE9 que buscar a otra alma sensible que pueda ayudarme. Pero
      gracias por intentarlo\u2026"
    m_Metadata:
      m_Items: []
  - m_Id: 521059082303
    m_Localized: "Ah, por fin\u2026 Una biblioteca con car\xE1cter."
    m_Metadata:
      m_Items: []
  - m_Id: 521059082304
    m_Localized: "No como esas modernas con luz m\xE1gica fr\xEDa."
    m_Metadata:
      m_Items: []
  - m_Id: 521059082305
    m_Localized: "Estoy buscando El Guardi\xE1n del Bosque Azul."
    m_Metadata:
      m_Items: []
  - m_Id: 521059082306
    m_Localized: "Las leyendas dicen que su autor nunca volvi\xF3 del bosque tras
      escribirlo."
    m_Metadata:
      m_Items: []
  - m_Id: 521059082307
    m_Localized: "Dicen que quien lee ese libro, empieza a o\xEDr susurros entre
      los \xE1rboles\u2026"
    m_Metadata:
      m_Items: []
  - m_Id: 521059082308
    m_Localized: "Me parece encantador, \xBFno?"
    m_Metadata:
      m_Items: []
  - m_Id: 521059082309
    m_Localized: "Necesito comprender la conexi\xF3n entre el artefacto y el linaje
      de los Guardianes."
    m_Metadata:
      m_Items: []
  - m_Id: 521059082310
    m_Localized: Solo ese libro lo detalla.
    m_Metadata:
      m_Items: []
  - m_Id: 521059082311
    m_Localized: "\xBFLo tienes?"
    m_Metadata:
      m_Items: []
  - m_Id: 521059082312
    m_Localized: "Lo encontraste\u2026"
    m_Metadata:
      m_Items: []
  - m_Id: 521059082313
    m_Localized: "\xBFLo sentiste tambi\xE9n?"
    m_Metadata:
      m_Items: []
  - m_Id: 521059082314
    m_Localized: Ese leve temblor cuando lo tocaste.
    m_Metadata:
      m_Items: []
  - m_Id: 521059082315
    m_Localized: "Est\xE1 vivo, de alguna forma."
    m_Metadata:
      m_Items: []
  - m_Id: 521059082316
    m_Localized: Gracias.
    m_Metadata:
      m_Items: []
  - m_Id: 521059082317
    m_Localized: "Interesante\u2026"
    m_Metadata:
      m_Items: []
  - m_Id: 521059082318
    m_Localized: "pero no lo que ped\xED."
    m_Metadata:
      m_Items: []
  - m_Id: 521059082319
    m_Localized: "\xBFTal vez el bosque te susurr\xF3 mal?"
    m_Metadata:
      m_Items: []
  - m_Id: 521059082320
    m_Localized: Vengo a devolverte esto...
    m_Metadata:
      m_Items: []
  - m_Id: 521059082321
    m_Localized: "Volver\xE9 de nuevo"
    m_Metadata:
      m_Items: []
  - m_Id: 521059082322
    m_Localized: "Buen d\xEDa\u2026"
    m_Metadata:
      m_Items: []
  - m_Id: 521059082323
    m_Localized: Estoy buscando el Compendio de Plantas Susurrantes.
    m_Metadata:
      m_Items: []
  - m_Id: 521059082324
    m_Localized: Lo necesito con cierta urgencia.
    m_Metadata:
      m_Items: []
  - m_Id: 521059082325
    m_Localized: "Es una edici\xF3n antigua, con ilustraciones detalladas."
    m_Metadata:
      m_Items: []
  - m_Id: 521059082326
    m_Localized: "La mayor\xEDa de las copias nuevas omitieron los comentarios sobre
      los efectos lunares."
    m_Metadata:
      m_Items: []
  - m_Id: 521059082327
    m_Localized: "Estoy haciendo una investigaci\xF3n sobre c\xF3mo la Zarza de Verdades
      reacciona bajo eclipses parciales."
    m_Metadata:
      m_Items: []
  - m_Id: 521059082328
    m_Localized: "Y no, no es para experimentar con nadie\u2026 todav\xEDa."
    m_Metadata:
      m_Items: []
  - m_Id: 521059082329
    m_Localized: "\xA1Oh! Este es. \xA1Qu\xE9 maravilla!"
    m_Metadata:
      m_Items: []
  - m_Id: 521059082330
    m_Localized: "Las ilustraciones... est\xE1n tal cual las describieron."
    m_Metadata:
      m_Items: []
  - m_Id: 521059082331
    m_Localized: "Incluso tiene el ap\xE9ndice sobre recolecci\xF3n en la tercera
      fase lunar."
    m_Metadata:
      m_Items: []
  - m_Id: 521059082332
    m_Localized: "Excelente. Esto va a ahorrarme semanas de prueba y error\u2026"
    m_Metadata:
      m_Items: []
  - m_Id: 521059082333
    m_Localized: "y probablemente unos cuantos sarpullidos m\xE1gicos."
    m_Metadata:
      m_Items: []
  - m_Id: 521059082334
    m_Localized: Hm... no, este no es.
    m_Metadata:
      m_Items: []
  - m_Id: 521059082335
    m_Localized: "Bueno\u2026 seguir\xE9 buscando. Gracias igual."
    m_Metadata:
      m_Items: []
  - m_Id: 521059082336
    m_Localized: "Buen d\xEDa\u2026 vine a devolver esto"
    m_Metadata:
      m_Items: []
  - m_Id: 521059082337
    m_Localized: Muchas gracias
    m_Metadata:
      m_Items: []
  - m_Id: 521059082338
    m_Localized: "Me dijeron que aqu\xED se encuentra\u2026"
    m_Metadata:
      m_Items: []
  - m_Id: 521059082339
    m_Localized: "Algo dif\xEDcil de conservar."
    m_Metadata:
      m_Items: []
  - m_Id: 521059082340
    m_Localized: Busco un volumen que no suele quedarse quieto.
    m_Metadata:
      m_Items: []
  - m_Id: 521059082341
    m_Localized: "Relatos que hablan m\xE1s all\xE1 de lo visible\u2026"
    m_Metadata:
      m_Items: []
  - m_Id: 521059082342
    m_Localized: de cosas que solo se sienten en el silencio.
    m_Metadata:
      m_Items: []
  - m_Id: 521059082343
    m_Localized: "Me han dicho que aqu\xED podr\xEDan tenerlo\u2026 aunque pocos
      se atreven a buscarlo."
    m_Metadata:
      m_Items: []
  - m_Id: 521059082344
    m_Localized: "Ah\u2026 lo reconoc\xED por el leve temblor en la mesa."
    m_Metadata:
      m_Items: []
  - m_Id: 521059082345
    m_Localized: Siempre reacciona cuando lo acercan a una mano que no le teme.
    m_Metadata:
      m_Items: []
  - m_Id: 521059082346
    m_Localized: "Gracias. Que sus noches sigan en silencio\u2026 si puede."
    m_Metadata:
      m_Items: []
  - m_Id: 521059082347
    m_Localized: No. Esto tiene palabras, pero ninguna que corte el aire.
    m_Metadata:
      m_Items: []
  - m_Id: 521059082348
    m_Localized: "No importa. A veces, el libro aparece solo cuando est\xE1 listo
      para ser le\xEDdo."
    m_Metadata:
      m_Items: []
  - m_Id: 521059082349
    m_Localized: "Adi\xF3s."
    m_Metadata:
      m_Items: []
  - m_Id: 521059082350
    m_Localized: Te traje esto
    m_Metadata:
      m_Items: []
  - m_Id: 521059082351
    m_Localized: Fue muy divertido
    m_Metadata:
      m_Items: []
  - m_Id: 521059082352
    m_Localized: Busco un libro que hable de equilibrio...
    m_Metadata:
      m_Items: []
  - m_Id: 521059082353
    m_Localized: y de los extremos entre la luz y la oscuridad.
    m_Metadata:
      m_Items: []
  - m_Id: 521059082354
    m_Localized: Hay historias de una joven con un poder que puede cambiarlo todo.
    m_Metadata:
      m_Items: []
  - m_Id: 521059082355
    m_Localized: Es raro, pero siento que este tomo guarda respuestas que necesito
      encontrar.
    m_Metadata:
      m_Items: []
  - m_Id: 521059082356
    m_Localized: "Esto\u2026 es lo que esperaba."
    m_Metadata:
      m_Items: []
  - m_Id: 521059082357
    m_Localized: "Aqu\xED est\xE1n las claves para entender la profec\xEDa."
    m_Metadata:
      m_Items: []
  - m_Id: 521059082358
    m_Localized: Gracias.
    m_Metadata:
      m_Items: []
  - m_Id: 521059082359
    m_Localized: "Esto podr\xEDa ser el comienzo para forjar un nuevo camino."
    m_Metadata:
      m_Items: []
  - m_Id: 521059082360
    m_Localized: "No es esto\u2026"
    m_Metadata:
      m_Items: []
  - m_Id: 521059082361
    m_Localized: Aunque pueda parecer importante, no es lo que busco.
    m_Metadata:
      m_Items: []
  - m_Id: 521059082362
    m_Localized: "Seguir\xE9 buscando."
    m_Metadata:
      m_Items: []
  - m_Id: 521059082363
    m_Localized: "Este conocimiento es demasiado vital para m\xED."
    m_Metadata:
      m_Items: []
  - m_Id: 9123637500747776
    m_Localized: "Buenos d\xEDas cari\xF1o..."
    m_Metadata:
      m_Items: []
  - m_Id: 9123637517524992
    m_Localized: Estaba buscando una receta para cocinar con hongos venenosos y hacerlos
      inofensivos para su consumo
    m_Metadata:
      m_Items: []
  - m_Id: 9123637517524993
    m_Localized: "Y se me desarm\xF3 el libro..."
    m_Metadata:
      m_Items: []
  - m_Id: 9123637517524994
    m_Localized: "Ya s\xE9, estaba muy viejo ya, pero es legado de mi madre, y quisiera
      conservarlo..."
    m_Metadata:
      m_Items: []
  - m_Id: 9123637517524995
    m_Localized: "\xBFMe ayudas a ordenar nuevamente las p\xE1ginas?"
    m_Metadata:
      m_Items: []
  - m_Id: 9123637517524996
    m_Localized: "Me ser\xEDas de gran ayuda..."
    m_Metadata:
      m_Items: []
  - m_Id: 9123637517524997
    m_Localized: "Oh tesoro, \xA1muchas gracias!"
    m_Metadata:
      m_Items: []
  - m_Id: 9123637517524998
    m_Localized: "Qued\xF3 como nuevo..."
    m_Metadata:
      m_Items: []
  - m_Id: 9123637517524999
    m_Localized: Agradezco mucho tu ayuda.
    m_Metadata:
      m_Items: []
  - m_Id: 9123637517525000
    m_Localized: Oh, que pena que no pudo solucionarse.
    m_Metadata:
      m_Items: []
  - m_Id: 9123637517525001
    m_Localized: Gracias igual por tu ayuda.
    m_Metadata:
      m_Items: []
  - m_Id: 9123637525913600
    m_Localized: Hola... soy yo de nuevo.
    m_Metadata:
      m_Items: []
  - m_Id: 9123637525913601
    m_Localized: "Esta vez necesito que me ayudes con algo...\xBFPodr\xEDas?"
    m_Metadata:
      m_Items: []
  - m_Id: 9123637525913602
    m_Localized: "Estuve escribiendo un libro sobre las aventuras que viv\xED en
      mis viajes, pero necesito ayuda con la portada del libro."
    m_Metadata:
      m_Items: []
  - m_Id: 9123637525913603
    m_Localized: Soy muy bueno escribiendo pero no dibujando.
    m_Metadata:
      m_Items: []
  - m_Id: 9123637525913604
    m_Localized: "\xBFPodr\xE1s hacerlo?"
    m_Metadata:
      m_Items: []
  - m_Id: 9123637525913605
    m_Localized: "Deber\xEDa tener objetos que recuerden que mi viaje fue en velero,
      hacia una isla secreta donde devel\xE9 el misterio de un tesoro antiguo escondido..."
    m_Metadata:
      m_Items: []
  - m_Id: 9123637525913606
    m_Localized: Algo que haga que mis seguidores quieran leerlo inmediatamente...
    m_Metadata:
      m_Items: []
  - m_Id: 9123637525913607
    m_Localized: "Excelente, es justo lo que quer\xEDa..."
    m_Metadata:
      m_Items: []
  - m_Id: 9123637525913608
    m_Localized: Gracias, nos veremos nuevamente...
    m_Metadata:
      m_Items: []
  - m_Id: 9123637525913609
    m_Localized: "\xBFQu\xE9 es esto? \xBFAcaso no escuchaste lo que ped\xED?"
    m_Metadata:
      m_Items: []
  - m_Id: 9123637525913610
    m_Localized: "Buenos d\xEDas.."
    m_Metadata:
      m_Items: []
  - m_Id: 9123637525913611
    m_Localized: Hoy no vengo a pedirte ayuda..
    m_Metadata:
      m_Items: []
  - m_Id: 9123637525913612
    m_Localized: sino para que me puedas prestar un libro.
    m_Metadata:
      m_Items: []
  - m_Id: 9123637525913613
    m_Localized: Estoy buscando Las Runas de Salakhar...
    m_Metadata:
      m_Items: []
  - m_Id: 9123637525913614
    m_Localized: "Mi maestro me lo recomend\xF3 como inspiraci\xF3n para crear una
      nueva historia."
    m_Metadata:
      m_Items: []
  - m_Id: 9123637525913615
    m_Localized: "Que bueno que nadie lo haya llevado a\xFAn"
    m_Metadata:
      m_Items: []
  - m_Id: 9123637525913616
    m_Localized: "\xA1Muchas gracias por tu ayuda!"
    m_Metadata:
      m_Items: []
  - m_Id: 9123637525913617
    m_Localized: Esto no es lo que esperaba..
    m_Metadata:
      m_Items: []
  - m_Id: 9123637525913618
    m_Localized: "Qu\xE9 pena que no lo tengas, volver\xE9 otro d\xEDa a buscarlo."
    m_Metadata:
      m_Items: []
  - m_Id: 9123637525913629
    m_Localized: "Buenos d\xEDas coraz\xF3n..."
    m_Metadata:
      m_Items: []
  - m_Id: 9123637525913630
    m_Localized: Hoy vengo a solicitar que me prestes un libro
    m_Metadata:
      m_Items: []
  - m_Id: 9123637525913631
    m_Localized: Estoy necesitando conseguir Hierbas y Sabores de Reinos Olvidados...
    m_Metadata:
      m_Items: []
  - m_Id: 9123637525913632
    m_Localized: Mi hermana viene de visita y es muy exquisita en cuanto a todo lo
      referido al arte culinario...
    m_Metadata:
      m_Items: []
  - m_Id: 9123637525913633
    m_Localized: "Necesito sorprenderla, \xBFme ayudas con el libro?"
    m_Metadata:
      m_Items: []
  - m_Id: 9123637525913634
    m_Localized: "\xA1Oh cari\xF1o muchas gracias! "
    m_Metadata:
      m_Items: []
  - m_Id: 9123637525913635
    m_Localized: Agradezco tu ayuda...
    m_Metadata:
      m_Items: []
  - m_Id: 9123637525913636
    m_Localized: Prometo volver con algo para que pruebes, no te vas a arrepentir.
    m_Metadata:
      m_Items: []
  - m_Id: 9123637525913637
    m_Localized: Oh, no es esto lo que yo necesito...
    m_Metadata:
      m_Items: []
  - m_Id: 9123637525913638
    m_Localized: "Me arreglar\xE9 cocinando lo que s\xE9."
    m_Metadata:
      m_Items: []
  - m_Id: 9123637525913639
    m_Localized: Muchas gracias igual tesoro.
    m_Metadata:
      m_Items: []
  - m_Id: 9123637525913640
    m_Localized: "\xA1Hola! \xBFC\xF3mo est\xE1s hoy?"
    m_Metadata:
      m_Items: []
  - m_Id: 9123637525913641
    m_Localized: "Vengo porque tengo algo que quiz\xE1s pueda serte \xFAtil..."
    m_Metadata:
      m_Items: []
  - m_Id: 9123637525913642
    m_Localized: "Digo, ya que tienes una librer\xEDa..."
    m_Metadata:
      m_Items: []
  - m_Id: 9123637525913643
    m_Localized: "Limpiando encontr\xE9 este libro y pens\xE9 en tra\xE9rtelo para
      tu colecci\xF3n."
    m_Metadata:
      m_Items: []
  - m_Id: 9123637525913644
    m_Localized: "Espero que tengas un lindo d\xEDa."
    m_Metadata:
      m_Items: []
  - m_Id: 9123637525913645
    m_Localized: "\xA1Nos vemos!"
    m_Metadata:
      m_Items: []
  - m_Id: 9123637525913646
    m_Localized: "Mhh, t\xFA todav\xEDa por aqu\xED..."
    m_Metadata:
      m_Items: []
  - m_Id: 9123637525913647
    m_Localized: "Bien, calculo que a esta altura ya debes conocer m\xE1s sobre el
      funcionamiento de esta librer\xEDa..."
    m_Metadata:
      m_Items: []
  - m_Id: 9123637525913648
    m_Localized: Espero que ahora sepas responder correctamente mis preguntas.
    m_Metadata:
      m_Items: []
  - m_Id: 9123637525913649
    m_Localized: Veamos...
    m_Metadata:
      m_Items: []
  - m_Id: 9123637525913650
    m_Localized: Veo que estuviste estudiando bastante.
    m_Metadata:
      m_Items: []
  - m_Id: 9123637525913651
    m_Localized: "No puedo negar que Rhea no eligi\xF3 a cualquiera para reemplazarla."
    m_Metadata:
      m_Items: []
  - m_Id: 9123637525913652
    m_Localized: "Como lo supon\xEDa..."
    m_Metadata:
      m_Items: []
  - m_Id: 9123637525913653
    m_Localized: "No puedo creer que alguien tan mediocre siga al mando de esta librer\xEDa."
    m_Metadata:
      m_Items: []
  - m_Id: 9123637525913654
    m_Localized: "Lo hablar\xE9 con Rhea a su regreso."
    m_Metadata:
      m_Items: []
  - m_Id: 9123637525913655
    m_Localized: "Ah, eres t\xFA de nuevo..."
    m_Metadata:
      m_Items: []
  - m_Id: 9123637525913656
    m_Localized: Esperaba encontrar a Rhea.
    m_Metadata:
      m_Items: []
  - m_Id: 9123637525913657
    m_Localized: "Bueno, ya que est\xE1s aqu\xED te pregunto..."
    m_Metadata:
      m_Items: []
  - m_Id: 9123637525913658
    m_Localized: "Quisiera restaurar este libro, necesito arreglarlo para poder leer
      la informaci\xF3n que contiene."
    m_Metadata:
      m_Items: []
  - m_Id: 9123637525913659
    m_Localized: "Imagino que sabr\xE1s algo sobre runas antiguas..."
    m_Metadata:
      m_Items: []
  - m_Id: 9123637525913660
    m_Localized: "Para reconstruirlo necesito seguir el orden de este acertijo...
      \xBFMe ayudas?"
    m_Metadata:
      m_Items: []
  - m_Id: 9123637525913661
    m_Localized: '"Agua que fluye, tierra que sostiene y fuego que arrasa"'
    m_Metadata:
      m_Items: []
  - m_Id: 9123637525913662
    m_Localized: "\xA1Incre\xEDble! Lograste arreglarlo..."
    m_Metadata:
      m_Items: []
  - m_Id: 9123637525913663
    m_Localized: "Sinceramente no confiaba en que lo har\xEDas...Gracias."
    m_Metadata:
      m_Items: []
  - m_Id: 9123637525913664
    m_Localized: Oh no, eh perdido la oportunidad de leer sus secretos.
    m_Metadata:
      m_Items: []
  - m_Id: 9123637525913665
    m_Localized: "Sab\xEDa que no deb\xEDa dejar que me ayudes, eres una inexperta."
    m_Metadata:
      m_Items: []
  - m_Id: 9123637525913666
    m_Localized: Hola...Vengo en busca de tu ayuda.
    m_Metadata:
      m_Items: []
  - m_Id: 9123637525913667
    m_Localized: "Mi padre quiere publicar su libro y me pidi\xF3 que haga la tapa
      del mismo."
    m_Metadata:
      m_Items: []
  - m_Id: 9123637525913668
    m_Localized: "Francamente, s\xE9 que nunca voy a complacerlo, y lo que haga no
      lo convencer\xE1."
    m_Metadata:
      m_Items: []
  - m_Id: 9123637525913669
    m_Localized: Tienes fama de hacer buenas portadas, vine porque te han recomendado.
    m_Metadata:
      m_Items: []
  - m_Id: 9123637525913670
    m_Localized: "\xBFPodr\xE1s ayudarme? Quiero sacarme esta tarea de encima lo
      antes posible."
    m_Metadata:
      m_Items: []
  - m_Id: 9123637525913671
    m_Localized: "El libro habla sobre los descubrimientos astron\xF3micos realizados
      por los Elfos del C\xEDrculo del Cielo."
    m_Metadata:
      m_Items: []
  - m_Id: 9123637525913672
    m_Localized: "Principalmente la relaci\xF3n entre las diversas constelaciones"
    m_Metadata:
      m_Items: []
  - m_Id: 9123637525913673
    m_Localized: "Gracias, creo que le gustar\xE1..."
    m_Metadata:
      m_Items: []
  - m_Id: 9123637525913674
    m_Localized: "Mhhh no creo poder convencerlo, \xBFrealmente entendiste lo que
      te ped\xED?"
    m_Metadata:
      m_Items: []
  - m_Id: 9123637525913675
    m_Localized: "Creo que no eres tan buena como dicen por ah\xED..."
    m_Metadata:
      m_Items: []
  - m_Id: 9170868245274624
    m_Localized: "Buenos d\xEDas..."
    m_Metadata:
      m_Items: []
  - m_Id: 9170868257857536
    m_Localized: "\xBFC\xF3mo est\xE1s hoy?"
    m_Metadata:
      m_Items: []
  - m_Id: 9170868257857537
    m_Localized: Vengo a dejarte esto, era de mi finada esposa...
    m_Metadata:
      m_Items: []
  - m_Id: 9170868257857538
    m_Localized: "Y esa vieja era mala como las ara\xF1as, pero qu\xE9 bien cocinaba
      jeje"
    m_Metadata:
      m_Items: []
  - m_Id: 9170868262051840
    m_Localized: "Buenos d\xEDas..."
    m_Metadata:
      m_Items: []
  - m_Id: 9170868262051841
    m_Localized: Estoy buscando un libro...
    m_Metadata:
      m_Items: []
  - m_Id: 9170868262051842
    m_Localized: Uno que detalle tanto flora curativa como maldita
    m_Metadata:
      m_Items: []
  - m_Id: 9170868262051843
    m_Localized: "\xBFTienes algo por ah\xED que pueda ayudarme?"
    m_Metadata:
      m_Items: []
  - m_Id: 9170868262051844
    m_Localized: "\xA1Exactamente esto es lo que necesitaba!"
    m_Metadata:
      m_Items: []
  - m_Id: 9170868262051845
    m_Localized: Muchas gracias...
    m_Metadata:
      m_Items: []
  - m_Id: 9170868262051846
    m_Localized: "Pronto lo devolver\xE9"
    m_Metadata:
      m_Items: []
  - m_Id: 9170868262051847
    m_Localized: No, esto para nada es lo que estaba buscando...
    m_Metadata:
      m_Items: []
  - m_Id: 9170868262051848
    m_Localized: "Ver\xE9 si hay otra librer\xEDa m\xE1s completa que lo tenga."
    m_Metadata:
      m_Items: []
  - m_Id: 9170868262051849
    m_Localized: Hasta luego.
    m_Metadata:
      m_Items: []
  - m_Id: 9170868262051850
    m_Localized: Dibuja algo relacionado a ese tema.
    m_Metadata:
      m_Items: []
  - m_Id: 19616043035697152
    m_Localized: Hola... hoy vengo a dejarte esto
    m_Metadata:
      m_Items: []
  - m_Id: 19616043035697153
    m_Localized: "tal vez puedas dejarlo aqu\xED para que alguien m\xE1s le de un
      buen uso"
    m_Metadata:
      m_Items: []
  - m_Id: 19616043035697154
    m_Localized: "Buen d\xEDa.. he vuelto"
    m_Metadata:
      m_Items: []
  - m_Id: 19616043035697155
    m_Localized: Otra vez aparecieron esos mocosos
    m_Metadata:
      m_Items: []
  - m_Id: 19616043035697156
    m_Localized: se las ingeniaron para volver a molestar...
    m_Metadata:
      m_Items: []
  - m_Id: 19616043035697157
    m_Localized: "Necesito llevarme otro libro que los asuste m\xE1s.."
    m_Metadata:
      m_Items: []
  - m_Id: 19616043035697158
    m_Localized: "\xBFTienes Susurros Tras la Puerta Cerrada?"
    m_Metadata:
      m_Items: []
  - m_Id: 19616043035697159
    m_Localized: Excelente, creo que esto definitivamente los va a espantar...
    m_Metadata:
      m_Items: []
  - m_Id: 19616043035697160
    m_Localized: "No \xBFqu\xE9 es esto?"
    m_Metadata:
      m_Items: []
  - m_Id: 19616043035697161
    m_Localized: No voy a asustar ni a mi sombra con este libro...
    m_Metadata:
      m_Items: []
  - m_Id: 19616043035697162
    m_Localized: "Vengo por t\xED"
    m_Metadata:
      m_Items: []
  - m_Id: 19616043035697163
    m_Localized: Se que sabes de hechizos
    m_Metadata:
      m_Items: []
  - m_Id: 19616043035697164
    m_Localized: y necesito que me ayudes a abrir este libro para comunicarme con
      mis ancestros,
    m_Metadata:
      m_Items: []
  - m_Id: 19616043035697165
    m_Localized: "y as\xED pedirles los secretos de la juventud eterna."
    m_Metadata:
      m_Items: []
  - m_Id: 19616043035697166
    m_Localized: El orden de las runas es aire, luz y agua
    m_Metadata:
      m_Items: []
  - m_Id: 19616043035697167
    m_Localized: "\xA1Hazlo o te convierto en sapo!"
    m_Metadata:
      m_Items: []
  - m_Id: 19616043035697168
    m_Localized: "Excelente, ya sabr\xE1s cuando me veas si realmente funciona..."
    m_Metadata:
      m_Items: []
  - m_Id: 19616043035697169
    m_Localized: "Al final Don Vinagre ten\xEDa raz\xF3n sobre t\xED..."
    m_Metadata:
      m_Items: []
  - m_Id: 19616043035697170
    m_Localized: Hola, vengo a dejarte esto...
    m_Metadata:
      m_Items: []
  - m_Id: 19616043035697171
    m_Localized: "Seguro alguien le dar\xE1 m\xE1s uso que yo..."
    m_Metadata:
      m_Items: []
  - m_Id: 19616043035697172
    m_Localized: "\xA1Hola! \xA1Buen d\xEDa!"
    m_Metadata:
      m_Items: []
  - m_Id: 19616043035697173
    m_Localized: "Te devuelvo este libro, \xA1muchas gracias!"
    m_Metadata:
      m_Items: []
  - m_Id: 19616043035697174
    m_Localized: "Hola ni\xF1a bonita..."
    m_Metadata:
      m_Items: []
  - m_Id: 19616043035697175
    m_Localized: Vengo a que me ayudes a curar mi resfriado...
    m_Metadata:
      m_Items: []
  - m_Id: 19616043035697176
    m_Localized: "Encontr\xE9 un hechizo, pero debido a mis temblorosas manos no
      puedo lograrlo"
    m_Metadata:
      m_Items: []
  - m_Id: 19616043035697177
    m_Localized: "\xBFPodr\xEDas hacerlo por m\xED?"
    m_Metadata:
      m_Items: []
  - m_Id: 19616043035697178
    m_Localized: "Muchas gracias cari\xF1o"
    m_Metadata:
      m_Items: []
  - m_Id: 19616043035697179
    m_Localized: ya me siento mucho mejor...
    m_Metadata:
      m_Items: []
  - m_Id: 19616043035697180
    m_Localized: Cof Cof, veo que sigo igual
    m_Metadata:
      m_Items: []
  - m_Id: 19616043035697181
    m_Localized: "No te preocupes, pronto se me pasar\xE1."
    m_Metadata:
      m_Items: []
  - m_Id: 19616043039891456
    m_Localized: Hola, te devuelvo esto.
    m_Metadata:
      m_Items: []
  - m_Id: 19616043039891457
    m_Localized: Hasta luego...
    m_Metadata:
      m_Items: []
  - m_Id: 19616043039891458
    m_Localized: "\xA1Hola! \xBFC\xF3mo est\xE1s hoy?"
    m_Metadata:
      m_Items: []
  - m_Id: 19616043039891459
    m_Localized: Vine a darte algo, seguramente te va a servir...
    m_Metadata:
      m_Items: []
  - m_Id: 19616043039891460
    m_Localized: "Encontr\xE9 este libro, y creo que va a ser \xFAtil en tu biblioteca..."
    m_Metadata:
      m_Items: []
  - m_Id: 19616043039891461
    m_Localized: "\xA1Nos vemos!"
    m_Metadata:
      m_Items: []
  - m_Id: 19616043039891462
    m_Localized: "Uf, veo que sigues aqu\xED"
    m_Metadata:
      m_Items: []
  - m_Id: 19616043039891463
    m_Localized: Vengo a ponerte a prueba, pero esta vez no con preguntas...
    m_Metadata:
      m_Items: []
  - m_Id: 19616043039891464
    m_Localized: Vengo por un libro
    m_Metadata:
      m_Items: []
  - m_Id: 19616043039891465
    m_Localized: que habla sobre una sociedad secreta, que gobierna en las sombras.
    m_Metadata:
      m_Items: []
  - m_Id: 19616043039891466
    m_Localized: "A ver si puedes descubrir cu\xE1l es..."
    m_Metadata:
      m_Items: []
  - m_Id: 19616043039891467
    m_Localized: "Mhh, lamentablemente sabes de qu\xE9 hablo."
    m_Metadata:
      m_Items: []
  - m_Id: 19616043039891468
    m_Localized: Igualmente no le llegas ni a los talones a Rhea.
    m_Metadata:
      m_Items: []
  - m_Id: 19616043039891469
    m_Localized: "Jeje, sab\xEDa que fallar\xEDas"
    m_Metadata:
      m_Items: []
  - m_Id: 19616043039891470
    m_Localized: Devuelvo esto...
    m_Metadata:
      m_Items: []
  - m_Id: 19616043039891471
    m_Localized: "para que veas que jam\xE1s me quedo con cosas que no son m\xEDas."
    m_Metadata:
      m_Items: []
  - m_Id: 19616043039891472
    m_Localized: "\xA1Hola! \xBFC\xF3mo est\xE1s hoy?"
    m_Metadata:
      m_Items: []
  - m_Id: 19616043039891473
    m_Localized: Vengo a regalarte este libro
    m_Metadata:
      m_Items: []
  - m_Id: 19616043039891474
    m_Localized: ya que has sido de mucha ayuda
    m_Metadata:
      m_Items: []
  - m_Id: 19616043039891475
    m_Localized: "\xA1Nos vemos pronto!"
    m_Metadata:
      m_Items: []
  - m_Id: 19616043039891476
    m_Localized: "Buen d\xEDa..."
    m_Metadata:
      m_Items: []
  - m_Id: 19616043039891477
    m_Localized: te traigo esto de vuelta.
    m_Metadata:
      m_Items: []
  - m_Id: 19616043039891478
    m_Localized: Gracias por prestarlo, nos vemos.
    m_Metadata:
      m_Items: []
  - m_Id: 19616043039891479
    m_Localized: "\xA1Hola! Vengo por tu ayuda.."
    m_Metadata:
      m_Items: []
  - m_Id: 19616043039891480
    m_Localized: Me han dicho que eres experta en dar ayuda a las personas
    m_Metadata:
      m_Items: []
  - m_Id: 19616043039891481
    m_Localized: y es por eso que vine...
    m_Metadata:
      m_Items: []
  - m_Id: 19616043039891482
    m_Localized: "En donde vivo, hay una princesa que qued\xF3 atrapada en un espejo
      de tanto mirarse"
    m_Metadata:
      m_Items: []
  - m_Id: 19616043039891483
    m_Localized: y sus padres me pidieron ayuda para rescatarla
    m_Metadata:
      m_Items: []
  - m_Id: 19616043039891484
    m_Localized: "Encontr\xE9 el conjuro que deshace el hechizo, pero no puedo descifrarlo..."
    m_Metadata:
      m_Items: []
  - m_Id: 19616043039891485
    m_Localized: "\xBFMe ayudar\xEDas a traducirlo?"
    m_Metadata:
      m_Items: []
  - m_Id: 19616043039891486
    m_Localized: "Solo debes elegir la letra correspondiente a la del alfabeto r\xFAnico,"
    m_Metadata:
      m_Items: []
  - m_Id: 19616043039891487
    m_Localized: "y as\xED ir traduciendo la frase."
    m_Metadata:
      m_Items: []
  - m_Id: 19616043039891488
    m_Localized: "\xA1Oh! \xA1Muchas gracias! "
    m_Metadata:
      m_Items: []
  - m_Id: 19616043039891489
    m_Localized: Has salvado a la princesa de mi reino
    m_Metadata:
      m_Items: []
  - m_Id: 19616043039891490
    m_Localized: "seguramente pronto ser\xE1s recompensada..."
    m_Metadata:
      m_Items: []
  - m_Id: 19616043039891491
    m_Localized: "\xA1Oh no! No podr\xE9 salvar a la princesa y los reyes van a exiliarme."
    m_Metadata:
      m_Items: []
  - m_Id: 19616043039891492
    m_Localized: para lograr este hechizo contra el mal de ojos...
    m_Metadata:
      m_Items: []
  - m_Id: 19616043039891493
    m_Localized: "\xA1Excelente! Eres muy buena en esto..."
    m_Metadata:
      m_Items: []
  - m_Id: 19616043039891494
    m_Localized: "\xBFHas pensado dedicarte a la magia?"
    m_Metadata:
      m_Items: []
  - m_Id: 19616043039891495
    m_Localized: Nos vemos pronto...
    m_Metadata:
      m_Items: []
  - m_Id: 19616043039891496
    m_Localized: "Oh, est\xE1 bien"
    m_Metadata:
      m_Items: []
  - m_Id: 19616043039891497
    m_Localized: "seguir\xE9 practicando en mi caba\xF1a..."
    m_Metadata:
      m_Items: []
  - m_Id: 19616043039891498
    m_Localized: "\xA1Buenos d\xEDas!"
    m_Metadata:
      m_Items: []
  - m_Id: 19616043039891499
    m_Localized: "Hoy vengo a buscar un libro, ya que esto es una librer\xEDa jeje"
    m_Metadata:
      m_Items: []
  - m_Id: 19616043039891500
    m_Localized: Lo necesito para mis clases de pociones...
    m_Metadata:
      m_Items: []
  - m_Id: 19616043039891501
    m_Localized: "contiene recetas basadas en las emociones humanas b\xE1sicas."
    m_Metadata:
      m_Items: []
  - m_Id: 19616043039891502
    m_Localized: "\xBFPuedes prest\xE1rmelo?"
    m_Metadata:
      m_Items: []
  - m_Id: 19616043039891503
    m_Localized: "Muchas gracias, ma\xF1ana mismo comienzo a practicar."
    m_Metadata:
      m_Items: []
  - m_Id: 19616043039891504
    m_Localized: "Creo que con esto no podr\xE9 hacer mucho..."
    m_Metadata:
      m_Items: []
  - m_Id: 19616043039891505
    m_Localized: "\xA1Buen d\xEDa! "
    m_Metadata:
      m_Items: []
  - m_Id: 19616043039891506
    m_Localized: "Qu\xE9 hermoso est\xE1 afuera hoy, \xBFno crees?"
    m_Metadata:
      m_Items: []
  - m_Id: 19616043039891507
    m_Localized: Necesito de tu ayuda, me han dicho que ya has reparado varios libros.
    m_Metadata:
      m_Items: []
  - m_Id: 19616043039891508
    m_Localized: "Estaba por comenzar a preparar una poci\xF3n para mi crush"
    m_Metadata:
      m_Items: []
  - m_Id: 19616043039891509
    m_Localized: "y... \xA1se me desarm\xF3 todo el libro!"
    m_Metadata:
      m_Items: []
  - m_Id: 19616043039891510
    m_Localized: "Es un desastre, ahora jam\xE1s podr\xE9 conquistarlo..."
    m_Metadata:
      m_Items: []
  - m_Id: 19616043039891511
    m_Localized: "Por favor, \xBFme ayudas?"
    m_Metadata:
      m_Items: []
  - m_Id: 19616043039891512
    m_Localized: Te lo suplico...
    m_Metadata:
      m_Items: []
  - m_Id: 19616043039891513
    m_Localized: "Oh, esto es \xA1PERFECTO!"
    m_Metadata:
      m_Items: []
  - m_Id: 19616043039891514
    m_Localized: "\xA1Muchas gracias! Eres la mejor de todas"
    m_Metadata:
      m_Items: []
  - m_Id: 19616043039891515
    m_Localized: "No puede ser, as\xED jam\xE1s podr\xE1 fijarse en mi..."
    m_Metadata:
      m_Items: []
  - m_Id: 19616043039891516
    m_Localized: "\xA1Hola! \xBFC\xF3mo est\xE1s?"
    m_Metadata:
      m_Items: []
  - m_Id: 19616043039891517
    m_Localized: "Estoy buscando Banquete de Lunas Llenas \xBFLo tienes?"
    m_Metadata:
      m_Items: []
  - m_Id: 19616043039891518
    m_Localized: Estoy intentando nuevas recetas, para cocinarle a mi futuro prometido
    m_Metadata:
      m_Items: []
  - m_Id: 19616043039891519
    m_Localized: "Ya que dicen que el amor entra por el est\xF3mago..."
    m_Metadata:
      m_Items: []
  - m_Id: 19616043039891520
    m_Localized: "\xBFNo es cierto?"
    m_Metadata:
      m_Items: []
  - m_Id: 19616043039891521
    m_Localized: "Oh \xA1muchas gracias! Te lo agradezo de verdad..."
    m_Metadata:
      m_Items: []
  - m_Id: 19616043039891522
    m_Localized: Me has salvado
    m_Metadata:
      m_Items: []
  - m_Id: 19616043039891523
    m_Localized: "Oh que pena, tendr\xE9 que intentar con otras recetas m\xE1s simples..."
    m_Metadata:
      m_Items: []
  - m_Id: 19616043039891524
    m_Localized: "Hola, \xBFque tal?"
    m_Metadata:
      m_Items: []
  - m_Id: 19616043039891525
    m_Localized: "Me han recomendado esta librer\xEDa..."
    m_Metadata:
      m_Items: []
  - m_Id: 19616043039891526
    m_Localized: "me dijeron que tiene todo lo que podr\xEDa necesitar."
    m_Metadata:
      m_Items: []
  - m_Id: 19616043039891527
    m_Localized: En este caso estoy buscando un libro sobre un eclipse
    m_Metadata:
      m_Items: []
  - m_Id: 19616043039891528
    m_Localized: "uno que dur\xF3 siete d\xEDas y detuvo el tiempo.."
    m_Metadata:
      m_Items: []
  - m_Id: 19616043039891529
    m_Localized: "\xBFMe lo prestar\xEDas?"
    m_Metadata:
      m_Items: []
  - m_Id: 19616043039891530
    m_Localized: "Es para una investigaci\xF3n que realizo"
    m_Metadata:
      m_Items: []
  - m_Id: 19616043039891531
    m_Localized: Perfecto, es este...
    m_Metadata:
      m_Items: []
  - m_Id: 19616043039891532
    m_Localized: "Muchas gracias, lo devolver\xE9"
    m_Metadata:
      m_Items: []
  - m_Id: 19616043039891533
    m_Localized: "Creo que este libro no habla de ning\xFAn eclipse."
    m_Metadata:
      m_Items: []
  - m_Id: 19919679578087424
    m_Localized: Hola, vengo a buscar un libro.
    m_Metadata:
      m_Items: []
  - m_Id: 19919679611641856
    m_Localized: No recuerdo su nombre...
    m_Metadata:
      m_Items: []
  - m_Id: 19919679611641857
    m_Localized: "s\xF3lo s\xE9 que trata sobre personas que desaparecen al comprar
      un misterioso libro."
    m_Metadata:
      m_Items: []
  - m_Id: 19919679611641858
    m_Localized: "\xBFRecordar\xE1s su nombre?"
    m_Metadata:
      m_Items: []
  - m_Id: 19919679611641859
    m_Localized: Gracias, es el libro que estaba buscando.
    m_Metadata:
      m_Items: []
  - m_Id: 19919679611641860
    m_Localized: Cuando lo termine te lo devuelvo,
    m_Metadata:
      m_Items: []
  - m_Id: 19919679611641861
    m_Localized: si es que no desaparezco je
    m_Metadata:
      m_Items: []
  - m_Id: 19919679611641862
    m_Localized: No creo que este sea el libro que buscaba
    m_Metadata:
      m_Items: []
  - m_Id: 19919679620030464
    m_Localized: Nos vemos.
    m_Metadata:
      m_Items: []
  - m_Id: 19919679620030465
    m_Localized: "te falta mucho por aprender todav\xEDa..."
    m_Metadata:
      m_Items: []
  references:
    version: 2
    RefIds: []
