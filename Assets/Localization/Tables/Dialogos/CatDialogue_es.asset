  m_Script: {fileID: 11500000, guid: e9620f8c34305754d8cc9a7e49e852d9, type: 3}
  m_Name: CatDialogue_es
  m_EditorClassIdentifier: 
  m_LocaleId:
    m_Code: es
  m_SharedData: {fileID: 11400000, guid: 70715c09457dd1c4a92263855647757e, type: 2}
  m_Metadata:
    m_Items: []
  m_TableData:
  - m_Id: 22856965201920
    m_Localized: "\xA1Hola! Soy Minino, tu asistente en esta librer\xEDa m\xE1gica."
    m_Metadata:
      m_Items: []
  - m_Id: 23021344169984
    m_Localized: "Cada d\xEDa vendr\xE1n criaturas distintas buscando libros."
    m_Metadata:
      m_Items: []
  - m_Id: 23075161284608
    m_Localized: "Recomendales libros seg\xFAn sus gustos o el que buscan exactamente."
    m_Metadata:
      m_Items: []
  - m_Id: 23111186161664
    m_Localized: "Pero antes de recibir clientes, deber\xEDas limpiar un poco este
      lugar..."
    m_Metadata:
      m_Items: []
  - m_Id: 23153548632064
    m_Localized: "Puedes consultar tu lista de tareas para saber qu\xE9 hacer."
    m_Metadata:
      m_Items: []
  - m_Id: 23183865061376
    m_Localized: "\xA1Buen trabajo ayer!"
    m_Metadata:
      m_Items: []
  - m_Id: 23218036056064
    m_Localized: "Hoy los clientes ser\xE1n un poco m\xE1s exigentes \xA1Y yo igual!"
    m_Metadata:
      m_Items: []
  - m_Id: 23266669010944
    m_Localized: No puedes dejarme sin comer ni cepillarme.
    m_Metadata:
      m_Items: []
  - m_Id: 23297421647872
    m_Localized: "Y deber\xEDas cuidar las plantas del patio o Rhea se pondr\xE1
      triste cuando vuelva..."
    m_Metadata:
      m_Items: []
  - m_Id: 23328451108864
    m_Localized: "Pero por el resto vas bien \xA1Sigue as\xED!"
    m_Metadata:
      m_Items: []
  - m_Id: 23374785585152
    m_Localized: "Sin duda Rhea eligi\xF3 a la persona correcta para cuidar este
      lugar."
    m_Metadata:
      m_Items: []
  - m_Id: 23405416587264
    m_Localized: "As\xED que creo que podr\xEDamos abrir la sala de lectura a partir
      de hoy."
    m_Metadata:
      m_Items: []
  - m_Id: 23528523603968
    m_Localized: "No te preocupes, casi ni notar\xE1s que est\xE1 abierta."
    m_Metadata:
      m_Items: []
  - m_Id: 23590574137344
    m_Localized: "\xA1Buena suerte!"
    m_Metadata:
      m_Items: []
  - m_Id: 23630805901312
    m_Localized: "\xA1Ya eres todo un experto!"
    m_Metadata:
      m_Items: []
  - m_Id: 23664247087104
    m_Localized: "Puede que los clientes cada vez hagan pedidos m\xE1s diferentes..."
    m_Metadata:
      m_Items: []
  - m_Id: 23673839460352
    m_Localized: "\xA1Pero conf\xEDa en tu instinto de librero m\xE1gico!"
    m_Metadata:
      m_Items: []
  - m_Id: 23704256552960
    m_Localized: "\xA1Vas muy bien!"
    m_Metadata:
      m_Items: []
  - m_Id: 10497099322531840
    m_Localized: "Vaya, gracias a ti la librer\xEDa se est\xE1 haciendo conocida."
    m_Metadata:
      m_Items: []
  - m_Id: 10497099356086272
    m_Localized: "Se corre la voz de que la atenci\xF3n aqu\xED es excelente."
    m_Metadata:
      m_Items: []
  - m_Id: 10497099356086273
    m_Localized: "Quiz\xE1 podr\xEDamos atraer nuevos clientes\u2026"
    m_Metadata:
      m_Items: []
  - m_Id: 10497099356086274
    m_Localized: "Aunque podr\xEDa aparecer alg\xFAn que otro visitante indeseado\u2026"
    m_Metadata:
      m_Items: []
  - m_Id: 10497099356086275
    m_Localized: "Ah, no le des importancia a eso. \xA1A empezar otro d\xEDa!"
    m_Metadata:
      m_Items: []
  references:
    version: 2
    RefIds: []
