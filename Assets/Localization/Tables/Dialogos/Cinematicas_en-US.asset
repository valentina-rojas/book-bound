  m_SharedData: {fileID: 11400000, guid: f46e1649903d87647a6e9039203b727d, type: 2}
  m_Metadata:
    m_Items: []
  m_TableData:
  - m_Id: 23153254400
    m_Localized: Ah! You arrived just in time
    m_Metadata:
      m_Items: []
  - m_Id: 23232946176
    m_Localized: "I need to ask you a favor\u2026"
    m_Metadata:
      m_Items: []
  - m_Id: 23237140480
    m_Localized: I've received an urgent letter from the Circle of Wandering Archivists
    m_Metadata:
      m_Items: []
  - m_Id: 23237140481
    m_Localized: "An ancient tome has awakened and they need my help\u2026"
    m_Metadata:
      m_Items: []
  - m_Id: 23237140482
    m_Localized: "So\u2026 The bookshop is all yours for a little while\u2026"
    m_Metadata:
      m_Items: []
  - m_Id: 23237140483
    m_Localized: "Or two moons\u2026 or five\u2026"
    m_Metadata:
      m_Items: []
  - m_Id: 23237140484
    m_Localized: Time is flexible when traveling between portals
    m_Metadata:
      m_Items: []
  - m_Id: 23237140485
    m_Localized: "Take care of the customers\u2026"
    m_Metadata:
      m_Items: []
  - m_Id: 23237140486
    m_Localized: And don't forget to feed the cat
    m_Metadata:
      m_Items: []
  - m_Id: 23237140487
    m_Localized: Good luck, young one!
    m_Metadata:
      m_Items: []
  - m_Id: 23237140488
    m_Localized: Thank you for taking care of the bookshop!
    m_Metadata:
      m_Items: []
  - m_Id: 28532818733342720
    m_Localized: I'm back! It's so nice to see everything still in order.
    m_Metadata:
      m_Items: []
  - m_Id: 28532818766897152
    m_Localized: I've never seen the grimoires so well cared for... great job.
    m_Metadata:
      m_Items: []
  - m_Id: 28532818766897153
    m_Localized: If you want... the library will always have a place for you.
    m_Metadata:
      m_Items: []
  - m_Id: 28532818766897154
    m_Localized: An extra hand is always welcome...
    m_Metadata:
      m_Items: []
  references:
    version: 2
    RefIds: []
