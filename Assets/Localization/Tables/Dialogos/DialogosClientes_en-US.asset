%YAML 1.1
%TAG !u! tag:unity3d.com,2011:
--- !u!114 &11400000
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 0}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: e9620f8c34305754d8cc9a7e49e852d9, type: 3}
  m_Name: DialogosClientes_en-US
  m_EditorClassIdentifier: 
  m_LocaleId:
    m_Code: en-US
  m_SharedData: {fileID: 11400000, guid: 398c04003a7316346af2890274873762, type: 2}
  m_Metadata:
    m_Items: []
  m_TableData:
  - m_Id: 521054887936
    m_Localized: Listen...
    m_Metadata:
      m_Items: []
  - m_Id: 521054887937
    m_Localized: I need that Breviary of Elixirs and Liquid Spells...
    m_Metadata:
      m_Items: []
  - m_Id: 521054887938
    m_Localized: URGENT!!
    m_Metadata:
      m_Items: []
  - m_Id: 521054887939
    m_Localized: My neighbor has been bothering me with his infernal chickens for
      weeks...
    m_Metadata:
      m_Items: []
  - m_Id: 521054887940
    m_Localized: And frankly, I think it's time to turn him into a fern.
    m_Metadata:
      m_Items: []
  - m_Id: 521054887941
    m_Localized: Do you have it or not?
    m_Metadata:
      m_Items: []
  - m_Id: 521054887942
    m_Localized: "By my grandmother\u2019s cauldron!"
    m_Metadata:
      m_Items: []
  - m_Id: 521054887943
    m_Localized: This is it!
    m_Metadata:
      m_Items: []
  - m_Id: 521054887944
    m_Localized: I'm going to cook up a stew of revenge for that fool...
    m_Metadata:
      m_Items: []
  - m_Id: 521054887945
    m_Localized: I owe you one.
    m_Metadata:
      m_Items: []
  - m_Id: 521054887946
    m_Localized: If you ever want to get rid of a neighbor, come to my cabin.
    m_Metadata:
      m_Items: []
  - m_Id: 521054887947
    m_Localized: What is this?
    m_Metadata:
      m_Items: []
  - m_Id: 521054887948
    m_Localized: No, no, no! I want mushrooms.
    m_Metadata:
      m_Items: []
  - m_Id: 521054887949
    m_Localized: This doesn't work for me
    m_Metadata:
      m_Items: []
  - m_Id: 521054887951
    m_Localized: I came to return this
    m_Metadata:
      m_Items: []
  - m_Id: 521054887952
    m_Localized: It was very useful, I'll come back again
    m_Metadata:
      m_Items: []
  - m_Id: 521054887953
    m_Localized: This time I came to give, not to ask
    m_Metadata:
      m_Items: []
  - m_Id: 521054887954
    m_Localized: Maybe you'll find more use for it than I did
    m_Metadata:
      m_Items: []
  - m_Id: 521054887955
    m_Localized: Hey, hi!
    m_Metadata:
      m_Items: []
  - m_Id: 521054887956
    m_Localized: Sorry to come like this, but I need your urgent help.
    m_Metadata:
      m_Items: []
  - m_Id: 521054887957
    m_Localized: I was practicing an ancient bookbinding and...
    m_Metadata:
      m_Items: []
  - m_Id: 521054887958
    m_Localized: well...
    m_Metadata:
      m_Items: []
  - m_Id: 521054887959
    m_Localized: my book completely fell apart.
    m_Metadata:
      m_Items: []
  - m_Id: 521054887960
    m_Localized: The pages flew all over the place.
    m_Metadata:
      m_Items: []
  - m_Id: 521054887961
    m_Localized: If my teacher finds out, he will make me clean shelves for a week.
    m_Metadata:
      m_Items: []
  - m_Id: 521054887962
    m_Localized: Could you help me put them back in order?
    m_Metadata:
      m_Items: []
  - m_Id: 521054887963
    m_Localized: You did it!
    m_Metadata:
      m_Items: []
  - m_Id: 521054887964
    m_Localized: "I can\u2019t believe how well it turned out."
    m_Metadata:
      m_Items: []
  - m_Id: 521054887965
    m_Localized: It even looks like it never fell apart.
    m_Metadata:
      m_Items: []
  - m_Id: 521054887966
    m_Localized: My teacher won't find out anything...
    m_Metadata:
      m_Items: []
  - m_Id: 521054887967
    m_Localized: "And I\u2019ll be able to sleep peacefully tonight."
    m_Metadata:
      m_Items: []
  - m_Id: 521054887968
    m_Localized: Good day...
    m_Metadata:
      m_Items: []
  - m_Id: 521054887969
    m_Localized: I need that book...
    m_Metadata:
      m_Items: []
  - m_Id: 521054887970
    m_Localized: One full of stories to scare the kids hiding under my bed.
    m_Metadata:
      m_Items: []
  - m_Id: 521054887971
    m_Localized: I don't remember the name...
    m_Metadata:
      m_Items: []
  - m_Id: 521054887972
    m_Localized: But it had stories of cold hands, strange laughter in closets...
    m_Metadata:
      m_Items: []
  - m_Id: 521054887973
    m_Localized: and things peeking out from under the mattress.
    m_Metadata:
      m_Items: []
  - m_Id: 521054887974
    m_Localized: Just what I needed!
    m_Metadata:
      m_Items: []
  - m_Id: 521054887975
    m_Localized: Hehe...
    m_Metadata:
      m_Items: []
  - m_Id: 521054887976
    m_Localized: Perfect to scare those ethereal kids who squeak at my ankles at
      midnight.
    m_Metadata:
      m_Items: []
  - m_Id: 521054887977
    m_Localized: If I survive till tomorrow, I'll come tell you how it went.
    m_Metadata:
      m_Items: []
  - m_Id: 521054887978
    m_Localized: Let's see...
    m_Metadata:
      m_Items: []
  - m_Id: 521054887979
    m_Localized: And what is this?...
    m_Metadata:
      m_Items: []
  - m_Id: 521059082240
    m_Localized: If someone leaves a shoe under the bed tonight, I'll curse your
      slippers.
    m_Metadata:
      m_Items: []
  - m_Id: 521059082241
    m_Localized: Good day...
    m_Metadata:
      m_Items: []
  - m_Id: 521059082242
    m_Localized: I'm returning this to you
    m_Metadata:
      m_Items: []
  - m_Id: 521059082243
    m_Localized: You should have seen how those kids ran
    m_Metadata:
      m_Items: []
  - m_Id: 521059082244
    m_Localized: It was very fun
    m_Metadata:
      m_Items: []
  - m_Id: 521059082245
    m_Localized: Hello...
    m_Metadata:
      m_Items: []
  - m_Id: 521059082246
    m_Localized: Do you have a moment?
    m_Metadata:
      m_Items: []
  - m_Id: 521059082247
    m_Localized: I need your help with something.
    m_Metadata:
      m_Items: []
  - m_Id: 521059082248
    m_Localized: I've written a book about all my travels and discoveries, but...
    m_Metadata:
      m_Items: []
  - m_Id: 521059082249
    m_Localized: I'm not very good at drawing covers.
    m_Metadata:
      m_Items: []
  - m_Id: 521059082250
    m_Localized: I wanted something with a map, a compass...
    m_Metadata:
      m_Items: []
  - m_Id: 521059082251
    m_Localized: maybe a tiny dragon hidden among the mountains...
    m_Metadata:
      m_Items: []
  - m_Id: 521059082252
    m_Localized: Could you do it?
    m_Metadata:
      m_Items: []
  - m_Id: 521059082253
    m_Localized: It doesn't have to be perfect, just...
    m_Metadata:
      m_Items: []
  - m_Id: 521059082254
    m_Localized: something that makes you smile when you see it on the shelf.
    m_Metadata:
      m_Items: []
  - m_Id: 521059082255
    m_Localized: "It\u2019s... beautiful!"
    m_Metadata:
      m_Items: []
  - m_Id: 521059082256
    m_Localized: This one!
    m_Metadata:
      m_Items: []
  - m_Id: 521059082257
    m_Localized: You don't know how much it means to me.
    m_Metadata:
      m_Items: []
  - m_Id: 521059082258
    m_Localized: Every detail... it's just what I imagined.
    m_Metadata:
      m_Items: []
  - m_Id: 521059082259
    m_Localized: Thanks... really. You're amazing!
    m_Metadata:
      m_Items: []
  - m_Id: 521059082260
    m_Localized: What...?
    m_Metadata:
      m_Items: []
  - m_Id: 521059082261
    m_Localized: This is not what I imagined...
    m_Metadata:
      m_Items: []
  - m_Id: 521059082262
    m_Localized: Good...
    m_Metadata:
      m_Items: []
  - m_Id: 521059082263
    m_Localized: Or maybe bad...
    m_Metadata:
      m_Items: []
  - m_Id: 521059082264
    m_Localized: What time is it? Doesn't matter.
    m_Metadata:
      m_Items: []
  - m_Id: 521059082265
    m_Localized: I'm looking for The Lady of Lost Secrets.
    m_Metadata:
      m_Items: []
  - m_Id: 521059082266
    m_Localized: 'And before you ask: yes, it''s for me.'
    m_Metadata:
      m_Items: []
  - m_Id: 521059082267
    m_Localized: "And no, I\u2019m not telling you what I want it for."
    m_Metadata:
      m_Items: []
  - m_Id: 521059082268
    m_Localized: Hmm... yes, this is the one I was looking for.
    m_Metadata:
      m_Items: []
  - m_Id: 521059082269
    m_Localized: Thanks...
    m_Metadata:
      m_Items: []
  - m_Id: 521059082270
    m_Localized: What made you think I would be interested in a book like that?
    m_Metadata:
      m_Items: []
  - m_Id: 521059082271
    m_Localized: Ugh... doesn't matter.
    m_Metadata:
      m_Items: []
  - m_Id: 521059082272
    m_Localized: I brought this back...
    m_Metadata:
      m_Items: []
  - m_Id: 521059082273
    m_Localized: Thank you...
    m_Metadata:
      m_Items: []
  - m_Id: 521059082274
    m_Localized: "Hmpf. So you\u2019re the new person in charge..."
    m_Metadata:
      m_Items: []
  - m_Id: 521059082275
    m_Localized: How long have you been here? Hours? Minutes?
    m_Metadata:
      m_Items: []
  - m_Id: 521059082276
    m_Localized: It smells like incompetence...
    m_Metadata:
      m_Items: []
  - m_Id: 521059082277
    m_Localized: How about a little game to test your... "wisdom"?
    m_Metadata:
      m_Items: []
  - m_Id: 521059082278
    m_Localized: "Get ready. I won\u2019t accept mediocre answers."
    m_Metadata:
      m_Items: []
  - m_Id: 521059082279
    m_Localized: Not bad... for someone with so little potential.
    m_Metadata:
      m_Items: []
  - m_Id: 521059082280
    m_Localized: "I hope this wasn\u2019t just luck."
    m_Metadata:
      m_Items: []
  - m_Id: 521059082281
    m_Localized: "I\u2019m satisfied... for now. Don\u2019t get used to the praise."
    m_Metadata:
      m_Items: []
  - m_Id: 521059082282
    m_Localized: "I don\u2019t know whether to laugh or cry."
    m_Metadata:
      m_Items: []
  - m_Id: 521059082283
    m_Localized: "If you\u2019re going to occupy this position, at least pretend
      you know what you\u2019re doing."
    m_Metadata:
      m_Items: []
  - m_Id: 521059082284
    m_Localized: That was... painful. For both of us.
    m_Metadata:
      m_Items: []
  - m_Id: 521059082285
    m_Localized: "Better I leave. I can\u2019t see so much mediocrity together."
    m_Metadata:
      m_Items: []
  - m_Id: 521059082286
    m_Localized: "This book... isn\u2019t just any book, dear."
    m_Metadata:
      m_Items: []
  - m_Id: 521059082287
    m_Localized: Inside it holds a very ancient recipe...
    m_Metadata:
      m_Items: []
  - m_Id: 521059082288
    m_Localized: forbidden...
    m_Metadata:
      m_Items: []
  - m_Id: 521059082289
    m_Localized: forgotten on purpose by those who feared its power.
    m_Metadata:
      m_Items: []
  - m_Id: 521059082290
    m_Localized: If it fell into the wrong hands... it could unleash a disaster.
      Or worse.
    m_Metadata:
      m_Items: []
  - m_Id: 521059082291
    m_Localized: I need to enchant it, seal it with a special spell...
    m_Metadata:
      m_Items: []
  - m_Id: 521059082292
    m_Localized: "It\u2019s not difficult, you just need to add the right runes in
      order"
    m_Metadata:
      m_Items: []
  - m_Id: 521059082293
    m_Localized: "I would do it but my hands are already shaking and it\u2019s difficult"
    m_Metadata:
      m_Items: []
  - m_Id: 521059082294
    m_Localized: The runes you must use are earth, shadow, and fire, in that order
    m_Metadata:
      m_Items: []
  - m_Id: 521059082295
    m_Localized: Do you think you could help me?
    m_Metadata:
      m_Items: []
  - m_Id: 521059082296
    m_Localized: Wonderful!
    m_Metadata:
      m_Items: []
  - m_Id: 521059082297
    m_Localized: The book is sealed with a perfect spell.
    m_Metadata:
      m_Items: []
  - m_Id: 521059082298
    m_Localized: I trust that the knowledge contained here will remain safe... thanks
      to you.
    m_Metadata:
      m_Items: []
  - m_Id: 521059082299
    m_Localized: Oh heavens... something went wrong.
    m_Metadata:
      m_Items: []
  - m_Id: 521059082300
    m_Localized: This is not the spell I wanted...
    m_Metadata:
      m_Items: []
  - m_Id: 521059082301
    m_Localized: "If someone unwanted opens it... I don\u2019t want to imagine it."
    m_Metadata:
      m_Items: []
  - m_Id: 521059082302
    m_Localized: I will have to look for another sensitive soul to help me. But thanks
      for trying...
    m_Metadata:
      m_Items: []
  - m_Id: 521059082303
    m_Localized: Ah, finally... A library with character.
    m_Metadata:
      m_Items: []
  - m_Id: 521059082304
    m_Localized: Not like those modern ones with cold magical light.
    m_Metadata:
      m_Items: []
  - m_Id: 521059082305
    m_Localized: "I\u2019m looking for The Guardian of the Blue Forest."
    m_Metadata:
      m_Items: []
  - m_Id: 521059082306
    m_Localized: Legends say its author never returned from the forest after writing
      it.
    m_Metadata:
      m_Items: []
  - m_Id: 521059082307
    m_Localized: They say that whoever reads this book starts hearing whispers among
      trees.
    m_Metadata:
      m_Items: []
  - m_Id: 521059082308
    m_Localized: "I find it charming, don\u2019t you?"
    m_Metadata:
      m_Items: []
  - m_Id: 521059082309
    m_Localized: I need to understand the connection between the artifact and the
      Guardians' lineage.
    m_Metadata:
      m_Items: []
  - m_Id: 521059082310
    m_Localized: Only that book details it.
    m_Metadata:
      m_Items: []
  - m_Id: 521059082311
    m_Localized: Do you have it?
    m_Metadata:
      m_Items: []
  - m_Id: 521059082312
    m_Localized: You found it...
    m_Metadata:
      m_Items: []
  - m_Id: 521059082313
    m_Localized: Did you feel it too?
    m_Metadata:
      m_Items: []
  - m_Id: 521059082314
    m_Localized: That slight tremor when you touched it.
    m_Metadata:
      m_Items: []
  - m_Id: 521059082315
    m_Localized: "It\u2019s alive, in some way."
    m_Metadata:
      m_Items: []
  - m_Id: 521059082316
    m_Localized: Thanks.
    m_Metadata:
      m_Items: []
  - m_Id: 521059082317
    m_Localized: Interesting...
    m_Metadata:
      m_Items: []
  - m_Id: 521059082318
    m_Localized: but not what I asked for.
    m_Metadata:
      m_Items: []
  - m_Id: 521059082319
    m_Localized: Maybe the forest whispered to you wrong?
    m_Metadata:
      m_Items: []
  - m_Id: 521059082320
    m_Localized: "I\u2019ve come to return this to you..."
    m_Metadata:
      m_Items: []
  - m_Id: 521059082321
    m_Localized: I'll come back again.
    m_Metadata:
      m_Items: []
  - m_Id: 521059082322
    m_Localized: Good day...
    m_Metadata:
      m_Items: []
  - m_Id: 521059082323
    m_Localized: "I\u2019m looking for the Compendium of Whispering Plants."
    m_Metadata:
      m_Items: []
  - m_Id: 521059082324
    m_Localized: I need it urgently.
    m_Metadata:
      m_Items: []
  - m_Id: 521059082325
    m_Localized: "It\u2019s an old edition, with detailed illustrations."
    m_Metadata:
      m_Items: []
  - m_Id: 521059082326
    m_Localized: Most new copies omitted the comments on lunar effects.
    m_Metadata:
      m_Items: []
  - m_Id: 521059082327
    m_Localized: "I\u2019m doing research on how the Truth Bramble reacts under partial
      eclipses."
    m_Metadata:
      m_Items: []
  - m_Id: 521059082328
    m_Localized: "And no, it\u2019s not to experiment on anyone... yet."
    m_Metadata:
      m_Items: []
  - m_Id: 521059082329
    m_Localized: Oh! This is it. What a marvel!
    m_Metadata:
      m_Items: []
  - m_Id: 521059082330
    m_Localized: The illustrations are just as described.
    m_Metadata:
      m_Items: []
  - m_Id: 521059082331
    m_Localized: It even has the appendix on collection in the third lunar phase.
    m_Metadata:
      m_Items: []
  - m_Id: 521059082332
    m_Localized: Excellent. This will save me weeks of trial and error...
    m_Metadata:
      m_Items: []
  - m_Id: 521059082333
    m_Localized: and probably a few magical rashes.
    m_Metadata:
      m_Items: []
  - m_Id: 521059082334
    m_Localized: Hm... no, this is not it.
    m_Metadata:
      m_Items: []
  - m_Id: 521059082335
    m_Localized: "Well... I\u2019ll keep looking. Thanks anyway."
    m_Metadata:
      m_Items: []
  - m_Id: 521059082336
    m_Localized: "Good day\u2026 I came to return this"
    m_Metadata:
      m_Items: []
  - m_Id: 521059082337
    m_Localized: Thank you very much
    m_Metadata:
      m_Items: []
  - m_Id: 521059082338
    m_Localized: "They told me this is found here\u2026"
    m_Metadata:
      m_Items: []
  - m_Id: 521059082339
    m_Localized: Something hard to keep.
    m_Metadata:
      m_Items: []
  - m_Id: 521059082340
    m_Localized: "I\u2019m looking for a volume that rarely stays still."
    m_Metadata:
      m_Items: []
  - m_Id: 521059082341
    m_Localized: Stories that speak beyond the visible...
    m_Metadata:
      m_Items: []
  - m_Id: 521059082342
    m_Localized: of things only felt in silence.
    m_Metadata:
      m_Items: []
  - m_Id: 521059082343
    m_Localized: They told me you might have it here... though few dare to look.
    m_Metadata:
      m_Items: []
  - m_Id: 521059082344
    m_Localized: Ah... I recognized it by the slight tremor on the table.
    m_Metadata:
      m_Items: []
  - m_Id: 521059082345
    m_Localized: It always reacts when brought near a fearless hand.
    m_Metadata:
      m_Items: []
  - m_Id: 521059082346
    m_Localized: Thanks. May your nights remain silent... if you can.
    m_Metadata:
      m_Items: []
  - m_Id: 521059082347
    m_Localized: No. This has words, but none that cut the air.
    m_Metadata:
      m_Items: []
  - m_Id: 521059082348
    m_Localized: "It doesn\u2019t matter. Sometimes the book appears only when ready
      to be read."
    m_Metadata:
      m_Items: []
  - m_Id: 521059082349
    m_Localized: Goodbye.
    m_Metadata:
      m_Items: []
  - m_Id: 521059082350
    m_Localized: I brought this to you
    m_Metadata:
      m_Items: []
  - m_Id: 521059082351
    m_Localized: It was very fun
    m_Metadata:
      m_Items: []
  - m_Id: 521059082352
    m_Localized: "I\u2019m looking for a book about balance..."
    m_Metadata:
      m_Items: []
  - m_Id: 521059082353
    m_Localized: and the extremes between light and darkness.
    m_Metadata:
      m_Items: []
  - m_Id: 521059082354
    m_Localized: There are stories of a young woman with a power that can change
      everything.
    m_Metadata:
      m_Items: []
  - m_Id: 521059082355
    m_Localized: "It\u2019s rare, but I feel this tome holds answers I need to find."
    m_Metadata:
      m_Items: []
  - m_Id: 521059082356
    m_Localized: This... is what I expected.
    m_Metadata:
      m_Items: []
  - m_Id: 521059082357
    m_Localized: Here are the keys to understand the prophecy.
    m_Metadata:
      m_Items: []
  - m_Id: 521059082358
    m_Localized: Thanks.
    m_Metadata:
      m_Items: []
  - m_Id: 521059082359
    m_Localized: This could be the beginning to forge a new path.
    m_Metadata:
      m_Items: []
  - m_Id: 521059082360
    m_Localized: "This isn\u2019t it..."
    m_Metadata:
      m_Items: []
  - m_Id: 521059082361
    m_Localized: "Although it may seem important, it\u2019s not what I\u2019m looking
      for."
    m_Metadata:
      m_Items: []
  - m_Id: 521059082362
    m_Localized: "I\u2019ll keep searching."
    m_Metadata:
      m_Items: []
  - m_Id: 521059082363
    m_Localized: This knowledge is too vital to me.
    m_Metadata:
      m_Items: []
  - m_Id: 9123637500747776
    m_Localized: Good morning, darling...
    m_Metadata:
      m_Items: []
  - m_Id: 9123637517524992
    m_Localized: I was looking for a recipe to cook with poisonous mushrooms and
      make them harmless for consumption.
    m_Metadata:
      m_Items: []
  - m_Id: 9123637517524993
    m_Localized: And my book fell apart...
    m_Metadata:
      m_Items: []
  - m_Id: 9123637517524994
    m_Localized: "I know, it was already very old, but it\u2019s my mother\u2019s
      legacy, and I\u2019d like to preserve it..."
    m_Metadata:
      m_Items: []
  - m_Id: 9123637517524995
    m_Localized: Will you help me put the pages back in order?
    m_Metadata:
      m_Items: []
  - m_Id: 9123637517524996
    m_Localized: You would be such a great help...
    m_Metadata:
      m_Items: []
  - m_Id: 9123637517524997
    m_Localized: Oh sweetheart, thank you so much!
    m_Metadata:
      m_Items: []
  - m_Id: 9123637517524998
    m_Localized: It looks as good as new...
    m_Metadata:
      m_Items: []
  - m_Id: 9123637517524999
    m_Localized: I truly appreciate your help.
    m_Metadata:
      m_Items: []
  - m_Id: 9123637517525000
    m_Localized: "Oh, what a shame it couldn\u2019t be fixed."
    m_Metadata:
      m_Items: []
  - m_Id: 9123637517525001
    m_Localized: Thank you for your help anyway.
    m_Metadata:
      m_Items: []
  - m_Id: 9123637525913600
    m_Localized: "Hello... it\u2019s me again."
    m_Metadata:
      m_Items: []
  - m_Id: 9123637525913601
    m_Localized: This time I need you to help me with something... Could you?
    m_Metadata:
      m_Items: []
  - m_Id: 9123637525913602
    m_Localized: "I\u2019ve been writing a book about the adventures I lived on my
      journeys, but I need help with the cover of the book."
    m_Metadata:
      m_Items: []
  - m_Id: 9123637525913603
    m_Localized: "I\u2019m very good at writing, but not at drawing."
    m_Metadata:
      m_Items: []
  - m_Id: 9123637525913604
    m_Localized: Could you do it?
    m_Metadata:
      m_Items: []
  - m_Id: 9123637525913605
    m_Localized: It should have objects that remind readers that my journey was on
      a sailboat, to a secret island where I uncovered the mystery of an ancient
      hidden treasure...
    m_Metadata:
      m_Items: []
  - m_Id: 9123637525913606
    m_Localized: Something that makes my followers want to read it immediately...
    m_Metadata:
      m_Items: []
  - m_Id: 9123637525913607
    m_Localized: Excellent, this is just what I wanted...
    m_Metadata:
      m_Items: []
  - m_Id: 9123637525913608
    m_Localized: "Thank you, we\u2019ll see each other again..."
    m_Metadata:
      m_Items: []
  - m_Id: 9123637525913609
    m_Localized: "What is this? Didn\u2019t you listen to what I asked for?"
    m_Metadata:
      m_Items: []
  - m_Id: 9123637525913610
    m_Localized: Good morning...
    m_Metadata:
      m_Items: []
  - m_Id: 9123637525913611
    m_Localized: "Today I\u2019m not here to ask for your help..."
    m_Metadata:
      m_Items: []
  - m_Id: 9123637525913612
    m_Localized: but to see if you could lend me a book.
    m_Metadata:
      m_Items: []
  - m_Id: 9123637525913613
    m_Localized: "I\u2019m looking for The Runes of Salakhar..."
    m_Metadata:
      m_Items: []
  - m_Id: 9123637525913614
    m_Localized: My master recommended it to me as inspiration for creating a new
      story.
    m_Metadata:
      m_Items: []
  - m_Id: 9123637525913615
    m_Localized: "I\u2019m glad no one has borrowed it yet."
    m_Metadata:
      m_Items: []
  - m_Id: 9123637525913616
    m_Localized: Thank you so much for your help!
    m_Metadata:
      m_Items: []
  - m_Id: 9123637525913617
    m_Localized: This is not what I was expecting...
    m_Metadata:
      m_Items: []
  - m_Id: 9123637525913618
    m_Localized: "What a shame you don\u2019t have it, I\u2019ll come back another
      day to look for it."
    m_Metadata:
      m_Items: []
  - m_Id: 9123637525913629
    m_Localized: Good morning, my dear...
    m_Metadata:
      m_Items: []
  - m_Id: 9123637525913630
    m_Localized: "Today I\u2019ve come to ask if you could lend me a book."
    m_Metadata:
      m_Items: []
  - m_Id: 9123637525913631
    m_Localized: "I\u2019m in need of Herbs and Flavors of Forgotten Realms..."
    m_Metadata:
      m_Items: []
  - m_Id: 9123637525913632
    m_Localized: My sister is coming to visit, and she is very particular when it
      comes to the culinary arts...
    m_Metadata:
      m_Items: []
  - m_Id: 9123637525913633
    m_Localized: I need to surprise her, will you help me with the book?
    m_Metadata:
      m_Items: []
  - m_Id: 9123637525913634
    m_Localized: Oh darling, thank you so much!
    m_Metadata:
      m_Items: []
  - m_Id: 9123637525913635
    m_Localized: I truly appreciate your help...
    m_Metadata:
      m_Items: []
  - m_Id: 9123637525913636
    m_Localized: "I promise I\u2019ll return with something for you to taste, you
      won\u2019t regret it."
    m_Metadata:
      m_Items: []
  - m_Id: 9123637525913637
    m_Localized: Oh, this is not what I need...
    m_Metadata:
      m_Items: []
  - m_Id: 9123637525913638
    m_Localized: "I\u2019ll manage by cooking what I already know."
    m_Metadata:
      m_Items: []
  - m_Id: 9123637525913639
    m_Localized: Thank you anyway, sweetheart.
    m_Metadata:
      m_Items: []
  - m_Id: 9123637525913640
    m_Localized: Hello! How are you today?
    m_Metadata:
      m_Items: []
  - m_Id: 9123637525913641
    m_Localized: I came because I have something that might be useful to you...
    m_Metadata:
      m_Items: []
  - m_Id: 9123637525913642
    m_Localized: I mean, since you have a bookstore...
    m_Metadata:
      m_Items: []
  - m_Id: 9123637525913643
    m_Localized: "While cleaning, I found this book, Feast of Full Moons, and I thought
      I\u2019d bring it to you for your collection."
    m_Metadata:
      m_Items: []
  - m_Id: 9123637525913644
    m_Localized: I hope you have a lovely day.
    m_Metadata:
      m_Items: []
  - m_Id: 9123637525913645
    m_Localized: See you!
    m_Metadata:
      m_Items: []
  - m_Id: 9123637525913646
    m_Localized: "Mhh, you\u2019re still around\u2026"
    m_Metadata:
      m_Items: []
  - m_Id: 9123637525913647
    m_Localized: "Alright, I guess by now you must know more about how this bookstore
      works\u2026"
    m_Metadata:
      m_Items: []
  - m_Id: 9123637525913648
    m_Localized: I hope you can answer my questions correctly now.
    m_Metadata:
      m_Items: []
  - m_Id: 9123637525913649
    m_Localized: "Let\u2019s see\u2026"
    m_Metadata:
      m_Items: []
  - m_Id: 9123637525913650
    m_Localized: "I see you\u2019ve been studying quite a lot."
    m_Metadata:
      m_Items: []
  - m_Id: 9123637525913651
    m_Localized: "I can\u2019t deny that Rhea didn\u2019t just pick anyone to replace
      her."
    m_Metadata:
      m_Items: []
  - m_Id: 9123637525913652
    m_Localized: "As I suspected\u2026"
    m_Metadata:
      m_Items: []
  - m_Id: 9123637525913653
    m_Localized: "I can\u2019t believe someone so mediocre is still in charge of
      this bookstore."
    m_Metadata:
      m_Items: []
  - m_Id: 9123637525913654
    m_Localized: "I\u2019ll talk to Rhea when she gets back."
    m_Metadata:
      m_Items: []
  - m_Id: 9123637525913655
    m_Localized: "Ah, it\u2019s you again\u2026"
    m_Metadata:
      m_Items: []
  - m_Id: 9123637525913656
    m_Localized: I was hoping to find Rhea.
    m_Metadata:
      m_Items: []
  - m_Id: 9123637525913657
    m_Localized: "Well, since you\u2019re here, I\u2019ll ask you\u2026"
    m_Metadata:
      m_Items: []
  - m_Id: 9123637525913658
    m_Localized: "I\u2019d like to restore this book; I need to fix it so I can read
      the information it contains."
    m_Metadata:
      m_Items: []
  - m_Id: 9123637525913659
    m_Localized: "I imagine you know something about ancient runes\u2026"
    m_Metadata:
      m_Items: []
  - m_Id: 9123637525913660
    m_Localized: "To reconstruct it, I need to follow the order of this riddle\u2026
      Will you help me?"
    m_Metadata:
      m_Items: []
  - m_Id: 9123637525913661
    m_Localized: '"Flowing water, earth that sustains, and fire that destroys"'
    m_Metadata:
      m_Items: []
  - m_Id: 9123637525913662
    m_Localized: "Incredible! You managed to fix it\u2026"
    m_Metadata:
      m_Items: []
  - m_Id: 9123637525913663
    m_Localized: "Honestly, I didn\u2019t trust you would\u2026 Thank you."
    m_Metadata:
      m_Items: []
  - m_Id: 9123637525913664
    m_Localized: "Oh no, I\u2019ve lost the chance to read its secrets."
    m_Metadata:
      m_Items: []
  - m_Id: 9123637525913665
    m_Localized: "I knew I shouldn\u2019t let you help..."
    m_Metadata:
      m_Items: []
  - m_Id: 9123637525913666
    m_Localized: "Hello... I\u2019ve come seeking your help."
    m_Metadata:
      m_Items: []
  - m_Id: 9123637525913667
    m_Localized: My father wants to publish his book and he asked me to design the
      cover for it.
    m_Metadata:
      m_Items: []
  - m_Id: 9123637525913668
    m_Localized: "Frankly, I know I\u2019ll never please him, and whatever I do won\u2019t
      convince him."
    m_Metadata:
      m_Items: []
  - m_Id: 9123637525913669
    m_Localized: You have a reputation for making good covers, I came because you
      were recommended.
    m_Metadata:
      m_Items: []
  - m_Id: 9123637525913670
    m_Localized: Could you help me? I want to get this task off my shoulders as soon
      as possible.
    m_Metadata:
      m_Items: []
  - m_Id: 9123637525913671
    m_Localized: The book is about the astronomical discoveries made by him and the
      Elves of the Circle of the Sky.
    m_Metadata:
      m_Items: []
  - m_Id: 9123637525913672
    m_Localized: Mainly the relationship between the various constellations
    m_Metadata:
      m_Items: []
  - m_Id: 9123637525913673
    m_Localized: "Thank you, I think he\u2019ll like it..."
    m_Metadata:
      m_Items: []
  - m_Id: 9123637525913674
    m_Localized: "Mhhh, I don\u2019t think I\u2019ll be able to convince him, did
      you really understand what I asked for?"
    m_Metadata:
      m_Items: []
  - m_Id: 9123637525913675
    m_Localized: "I think you\u2019re not as great as they say..."
    m_Metadata:
      m_Items: []
  - m_Id: 9170868245274624
    m_Localized: Good morning...
    m_Metadata:
      m_Items: []
  - m_Id: 9170868257857536
    m_Localized: How are you today?
    m_Metadata:
      m_Items: []
  - m_Id: 9170868257857537
    m_Localized: I came to bring you this, it belonged to my late wife...
    m_Metadata:
      m_Items: []
  - m_Id: 9170868257857538
    m_Localized: And that old woman was as mean as a spider, but oh, she sure could
      cook hehe
    m_Metadata:
      m_Items: []
  - m_Id: 9170868262051840
    m_Localized: Good morning...
    m_Metadata:
      m_Items: []
  - m_Id: 9170868262051841
    m_Localized: "I\u2019m looking for a book..."
    m_Metadata:
      m_Items: []
  - m_Id: 9170868262051842
    m_Localized: One that contains recipes for balms with magical applications...
    m_Metadata:
      m_Items: []
  - m_Id: 9170868262051843
    m_Localized: Do you have something that might help me?
    m_Metadata:
      m_Items: []
  - m_Id: 9170868262051844
    m_Localized: This is exactly what I needed!
    m_Metadata:
      m_Items: []
  - m_Id: 9170868262051845
    m_Localized: Thank you so much...
    m_Metadata:
      m_Items: []
  - m_Id: 9170868262051846
    m_Localized: "I\u2019ll return it soon."
    m_Metadata:
      m_Items: []
  - m_Id: 9170868262051847
    m_Localized: No, this is not at all what I was looking for...
    m_Metadata:
      m_Items: []
  - m_Id: 9170868262051848
    m_Localized: "I\u2019ll see if there\u2019s another, more complete library that
      has it."
    m_Metadata:
      m_Items: []
  - m_Id: 9170868262051849
    m_Localized: Goodbye.
    m_Metadata:
      m_Items: []
  - m_Id: 9170868262051850
    m_Localized: Draw something related to that theme.
    m_Metadata:
      m_Items: []
  - m_Id: 19616043035697152
    m_Localized: Hello... today I came to leave this with you
    m_Metadata:
      m_Items: []
  - m_Id: 19616043035697153
    m_Localized: maybe you can leave it here so someone else can make good use of
      it.
    m_Metadata:
      m_Items: []
  - m_Id: 19616043035697154
    m_Localized: "Hello again... I\u2019m back."
    m_Metadata:
      m_Items: []
  - m_Id: 19616043035697155
    m_Localized: Those kids showed up again.
    m_Metadata:
      m_Items: []
  - m_Id: 19616043035697156
    m_Localized: hey managed to come back and cause trouble again...
    m_Metadata:
      m_Items: []
  - m_Id: 19616043035697157
    m_Localized: I need to get another book that will scare them more...
    m_Metadata:
      m_Items: []
  - m_Id: 19616043035697158
    m_Localized: Do you have Whispers Behind the Closed Door?
    m_Metadata:
      m_Items: []
  - m_Id: 19616043035697159
    m_Localized: Excellent, I think this will definitely scare them.
    m_Metadata:
      m_Items: []
  - m_Id: 19616043035697160
    m_Localized: "No, what\u2019s this?"
    m_Metadata:
      m_Items: []
  - m_Id: 19616043035697161
    m_Localized: "I\u2019m not even going to scare my own shadow with this book..."
    m_Metadata:
      m_Items: []
  - m_Id: 19616043035697162
    m_Localized: "I\u2019m coming for you"
    m_Metadata:
      m_Items: []
  - m_Id: 19616043035697163
    m_Localized: I know you know about spells
    m_Metadata:
      m_Items: []
  - m_Id: 19616043035697164
    m_Localized: and I need you to help me open this book to communicate with my
      ancestors.
    m_Metadata:
      m_Items: []
  - m_Id: 19616043035697165
    m_Localized: and thus ask them for the secrets of eternal youth
    m_Metadata:
      m_Items: []
  - m_Id: 19616043035697166
    m_Localized: The order of the runes is air, light, and water.
    m_Metadata:
      m_Items: []
  - m_Id: 19616043035697167
    m_Localized: "Do it, or I\u2019ll turn you into a toad!"
    m_Metadata:
      m_Items: []
  - m_Id: 19616043035697168
    m_Localized: "Excellent, you\u2019ll know when you see me if it really works..."
    m_Metadata:
      m_Items: []
  - m_Id: 19616043035697169
    m_Localized: After all, Don Vinagre was right about you...
    m_Metadata:
      m_Items: []
  - m_Id: 19616043035697170
    m_Localized: "Hi, I\u2019m here to leave this for you..."
    m_Metadata:
      m_Items: []
  - m_Id: 19616043035697171
    m_Localized: "I\u2019m sure someone else will put it to better use than I do..."
    m_Metadata:
      m_Items: []
  - m_Id: 19616043035697172
    m_Localized: "Hi! Good morning! Here\u2019s the book back."
    m_Metadata:
      m_Items: []
  - m_Id: 19616043035697173
    m_Localized: Thank you so much!
    m_Metadata:
      m_Items: []
  - m_Id: 19616043035697174
    m_Localized: Hello, darling... how are you today?
    m_Metadata:
      m_Items: []
  - m_Id: 19616043035697175
    m_Localized: "I\u2019ve come for you to help me cure my cold..."
    m_Metadata:
      m_Items: []
  - m_Id: 19616043035697176
    m_Localized: "I found a spell, but because of my trembling hands I can\u2019t
      manage it."
    m_Metadata:
      m_Items: []
  - m_Id: 19616043035697177
    m_Localized: Can you do it for me?
    m_Metadata:
      m_Items: []
  - m_Id: 19616043035697178
    m_Localized: Thank you very much, sweetheart
    m_Metadata:
      m_Items: []
  - m_Id: 19616043035697179
    m_Localized: "I\u2019m feeling much better now.."
    m_Metadata:
      m_Items: []
  - m_Id: 19616043035697180
    m_Localized: "Cough cough, I see I\u2019m still the same."
    m_Metadata:
      m_Items: []
  - m_Id: 19616043035697181
    m_Localized: "Don\u2019t worry, it will pass soon."
    m_Metadata:
      m_Items: []
  - m_Id: 19616043039891456
    m_Localized: "Hello, I\u2019m returning this to you"
    m_Metadata:
      m_Items: []
  - m_Id: 19616043039891457
    m_Localized: See you later...
    m_Metadata:
      m_Items: []
  - m_Id: 19616043039891458
    m_Localized: Hello! How are you today?
    m_Metadata:
      m_Items: []
  - m_Id: 19616043039891459
    m_Localized: I came to give you something; it will surely be useful to you..
    m_Metadata:
      m_Items: []
  - m_Id: 19616043039891460
    m_Localized: "I found this book, and I think it\u2019s going to be useful in
      your library..."
    m_Metadata:
      m_Items: []
  - m_Id: 19616043039891461
    m_Localized: See you!
    m_Metadata:
      m_Items: []
  - m_Id: 19616043039891462
    m_Localized: "Phew, I see you\u2019re still here."
    m_Metadata:
      m_Items: []
  - m_Id: 19616043039891463
    m_Localized: "I\u2019ve come to put you to the test, but this time not with questions..."
    m_Metadata:
      m_Items: []
  - m_Id: 19616043039891464
    m_Localized: "I\u2019ve come for a book"
    m_Metadata:
      m_Items: []
  - m_Id: 19616043039891465
    m_Localized: "It\u2019s about a secret society that operates in the shadows."
    m_Metadata:
      m_Items: []
  - m_Id: 19616043039891466
    m_Localized: "Let\u2019s see if you can figure out which one it is..."
    m_Metadata:
      m_Items: []
  - m_Id: 19616043039891467
    m_Localized: "Hmm, unfortunately, you know what I\u2019m talking about."
    m_Metadata:
      m_Items: []
  - m_Id: 19616043039891468
    m_Localized: "Even so, you\u2019re no match for Rhea."
    m_Metadata:
      m_Items: []
  - m_Id: 19616043039891469
    m_Localized: "Hehe, I knew you\u2019d fail."
    m_Metadata:
      m_Items: []
  - m_Id: 19616043039891470
    m_Localized: "I\u2019m returning this..."
    m_Metadata:
      m_Items: []
  - m_Id: 19616043039891471
    m_Localized: "So you can see that I never keep things that aren\u2019t mine."
    m_Metadata:
      m_Items: []
  - m_Id: 19616043039891472
    m_Localized: Hello! How are you today?
    m_Metadata:
      m_Items: []
  - m_Id: 19616043039891473
    m_Localized: "I\u2019m here to give you this book."
    m_Metadata:
      m_Items: []
  - m_Id: 19616043039891474
    m_Localized: "Since you\u2019ve been a great help."
    m_Metadata:
      m_Items: []
  - m_Id: 19616043039891475
    m_Localized: See you soon!
    m_Metadata:
      m_Items: []
  - m_Id: 19616043039891476
    m_Localized: Good morning...
    m_Metadata:
      m_Items: []
  - m_Id: 19616043039891477
    m_Localized: "\"Here\u2019s this back for you."
    m_Metadata:
      m_Items: []
  - m_Id: 19616043039891478
    m_Localized: Thanks for lending it to me, see you.
    m_Metadata:
      m_Items: []
  - m_Id: 19616043039891479
    m_Localized: "Hello! I\u2019ve come for your help..."
    m_Metadata:
      m_Items: []
  - m_Id: 19616043039891480
    m_Localized: "I was recommended to come here, since you\u2019ve solved several
      problems..."
    m_Metadata:
      m_Items: []
  - m_Id: 19616043039891481
    m_Localized: "And that\u2019s why I came..."
    m_Metadata:
      m_Items: []
  - m_Id: 19616043039891482
    m_Localized: "Where I live, there\u2019s a princess who got trapped in a mirror
      from looking at herself too much.\""
    m_Metadata:
      m_Items: []
  - m_Id: 19616043039891483
    m_Localized: And her parents asked me for help to rescue her
    m_Metadata:
      m_Items: []
  - m_Id: 19616043039891484
    m_Localized: "I found the spell that breaks the curse, but I can\u2019t decipher
      it..."
    m_Metadata:
      m_Items: []
  - m_Id: 19616043039891485
    m_Localized: Would you help me translate it?
    m_Metadata:
      m_Items: []
  - m_Id: 19616043039891486
    m_Localized: You just have to choose the letter corresponding to the runic alphabet.
    m_Metadata:
      m_Items: []
  - m_Id: 19616043039891487
    m_Localized: And in this way, you can translate the phrase.
    m_Metadata:
      m_Items: []
  - m_Id: 19616043039891488
    m_Localized: Oh! Thank you so much!
    m_Metadata:
      m_Items: []
  - m_Id: 19616043039891489
    m_Localized: "You\u2019ve saved the princess of my kingdom."
    m_Metadata:
      m_Items: []
  - m_Id: 19616043039891490
    m_Localized: Surely you will be rewarded soon...
    m_Metadata:
      m_Items: []
  - m_Id: 19616043039891491
    m_Localized: "Oh no! I can\u2019t save the princess, and the kings will exile
      me."
    m_Metadata:
      m_Items: []
  - m_Id: 19616043039891492
    m_Localized: to cast this spell against the evil eye...
    m_Metadata:
      m_Items: []
  - m_Id: 19616043039891493
    m_Localized: "Excellent! You\u2019re great at this..."
    m_Metadata:
      m_Items: []
  - m_Id: 19616043039891494
    m_Localized: Have you ever thought about dedicating yourself to magic?
    m_Metadata:
      m_Items: []
  - m_Id: 19616043039891495
    m_Localized: See you soon...
    m_Metadata:
      m_Items: []
  - m_Id: 19616043039891496
    m_Localized: Oh, alright.
    m_Metadata:
      m_Items: []
  - m_Id: 19616043039891497
    m_Localized: I will keep practicing in my cabin...
    m_Metadata:
      m_Items: []
  - m_Id: 19616043039891498
    m_Localized: Good morning!
    m_Metadata:
      m_Items: []
  - m_Id: 19616043039891499
    m_Localized: Today I came to look for a book, since this is a bookstore hehe.
    m_Metadata:
      m_Items: []
  - m_Id: 19616043039891500
    m_Localized: I need it for my potion classes...
    m_Metadata:
      m_Items: []
  - m_Id: 19616043039891501
    m_Localized: It's a book that stays warm to the touch and contains many potion
      recipes.
    m_Metadata:
      m_Items: []
  - m_Id: 19616043039891502
    m_Localized: Can you lend it to me?
    m_Metadata:
      m_Items: []
  - m_Id: 19616043039891503
    m_Localized: "Thank you very much, I\u2019ll start practicing tomorrow."
    m_Metadata:
      m_Items: []
  - m_Id: 19616043039891504
    m_Localized: "I think I won\u2019t be able to do much with this.."
    m_Metadata:
      m_Items: []
  - m_Id: 19616043039891505
    m_Localized: Good day!
    m_Metadata:
      m_Items: []
  - m_Id: 19616043039891506
    m_Localized: "It\u2019s beautiful outside today, don\u2019t you think?"
    m_Metadata:
      m_Items: []
  - m_Id: 19616043039891507
    m_Localized: "I need your help; I\u2019ve been told that you\u2019ve already
      repaired several books."
    m_Metadata:
      m_Items: []
  - m_Id: 19616043039891508
    m_Localized: I was about to start preparing a potion for my crush.
    m_Metadata:
      m_Items: []
  - m_Id: 19616043039891509
    m_Localized: "And\u2026 the whole book fell apart on me!"
    m_Metadata:
      m_Items: []
  - m_Id: 19616043039891510
    m_Localized: "It\u2019s a disaster; now I\u2019ll never be able to win them over..."
    m_Metadata:
      m_Items: []
  - m_Id: 19616043039891511
    m_Localized: Please, can you help me?
    m_Metadata:
      m_Items: []
  - m_Id: 19616043039891512
    m_Localized: I implore you...
    m_Metadata:
      m_Items: []
  - m_Id: 19616043039891513
    m_Localized: Oh, this is PERFECT!
    m_Metadata:
      m_Items: []
  - m_Id: 19616043039891514
    m_Localized: "Thank you so much! You\u2019re one of the best."
    m_Metadata:
      m_Items: []
  - m_Id: 19616043039891515
    m_Localized: "It can\u2019t be, this way they\u2019ll never notice me..."
    m_Metadata:
      m_Items: []
  - m_Id: 19616043039891516
    m_Localized: Hi! How are you?
    m_Metadata:
      m_Items: []
  - m_Id: 19616043039891517
    m_Localized: "I\u2019m looking for Banquet of Full Moons, do you have it?"
    m_Metadata:
      m_Items: []
  - m_Id: 19616043039891518
    m_Localized: "I\u2019m trying out new recipes to cook for my future husband."
    m_Metadata:
      m_Items: []
  - m_Id: 19616043039891519
    m_Localized: Since they say that love enters through the stomach...
    m_Metadata:
      m_Items: []
  - m_Id: 19616043039891520
    m_Localized: "Isn\u2019t it true?"
    m_Metadata:
      m_Items: []
  - m_Id: 19616043039891521
    m_Localized: Oh, thank you so much! I truly appreciate it...
    m_Metadata:
      m_Items: []
  - m_Id: 19616043039891522
    m_Localized: "You\u2019ve saved me."
    m_Metadata:
      m_Items: []
  - m_Id: 19616043039891523
    m_Localized: "Oh, what a pity, I\u2019ll have to try with simpler recipes..."
    m_Metadata:
      m_Items: []
  - m_Id: 19616043039891524
    m_Localized: Hello, how are you?
    m_Metadata:
      m_Items: []
  - m_Id: 19616043039891525
    m_Localized: "I\u2019ve been recommended this bookstore.."
    m_Metadata:
      m_Items: []
  - m_Id: 19616043039891526
    m_Localized: They told me you have everything I could need.
    m_Metadata:
      m_Items: []
  - m_Id: 19616043039891527
    m_Localized: "In this case, I\u2019m looking for a book about an eclipse."
    m_Metadata:
      m_Items: []
  - m_Id: 19616043039891528
    m_Localized: One that lasted seven days and stopped time...
    m_Metadata:
      m_Items: []
  - m_Id: 19616043039891529
    m_Localized: Could you lend it to me?
    m_Metadata:
      m_Items: []
  - m_Id: 19616043039891530
    m_Localized: "It\u2019s for a research I\u2019m doing."
    m_Metadata:
      m_Items: []
  - m_Id: 19616043039891531
    m_Localized: "Perfect, it\u2019s this one..."
    m_Metadata:
      m_Items: []
  - m_Id: 19616043039891532
    m_Localized: "Thank you very much, I\u2019ll return it."
    m_Metadata:
      m_Items: []
  - m_Id: 19616043039891533
    m_Localized: "I think this book doesn\u2019t talk about any eclipse."
    m_Metadata:
      m_Items: []
  - m_Id: 19919679578087424
    m_Localized: Hello, I'm here to look for a book.
    m_Metadata:
      m_Items: []
  - m_Id: 19919679611641856
    m_Localized: I don't remember its name...
    m_Metadata:
      m_Items: []
  - m_Id: 19919679611641857
    m_Localized: "I only know that it\u2019s about people who disappear after buying
      a mysterious book."
    m_Metadata:
      m_Items: []
  - m_Id: 19919679611641858
    m_Localized: Will you remember its name?
    m_Metadata:
      m_Items: []
  - m_Id: 19919679611641859
    m_Localized: "Thanks, that\u2019s the book I was looking for."
    m_Metadata:
      m_Items: []
  - m_Id: 19919679611641860
    m_Localized: "I\u2019ll give it back to you when I\u2019m done."
    m_Metadata:
      m_Items: []
  - m_Id: 19919679611641861
    m_Localized: Unless I disappear, haha.
    m_Metadata:
      m_Items: []
  - m_Id: 19919679611641862
    m_Localized: "I don\u2019t think this is the book I was looking for."
    m_Metadata:
      m_Items: []
  - m_Id: 19919679620030464
    m_Localized: See you.
    m_Metadata:
      m_Items: []
  - m_Id: 19919679620030465
    m_Localized: You still have a lot to learn...
    m_Metadata:
      m_Items: []
  references:
    version: 2
    RefIds: []
