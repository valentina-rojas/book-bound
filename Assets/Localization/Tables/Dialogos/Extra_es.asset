  m_Script: {fileID: 11500000, guid: e9620f8c34305754d8cc9a7e49e852d9, type: 3}
  m_Name: Extra_es
  m_EditorClassIdentifier: 
  m_LocaleId:
    m_Code: es
  m_SharedData: {fileID: 11400000, guid: 0017bb68c12ca3b43b8ad3fc80c23699, type: 2}
  m_Metadata:
    m_Items: []
  m_TableData:
  - m_Id: 71333224448
    m_Localized: "Comencemos quitando las telara\xF1as en la recepci\xF3n, puedes
      encontrar un plumero en tu inventario."
    m_Metadata:
      m_Items: []
  - m_Id: 71429693440
    m_Localized: Ahora ve a la biblioteca para organizar los libros.
    m_Metadata:
      m_Items: []
  - m_Id: 71429693441
    m_Localized: "Debes ordenarlos por g\xE9nero. Puedes leer de qu\xE9 trata cada
      libro para saber a qu\xE9 g\xE9nero pertenece, y no te preocupes, te dar\xE1s
      cuenta cuando est\xE9n bien organizados."
    m_Metadata:
      m_Items: []
  - m_Id: 71429693442
    m_Localized: "Te espero aqu\xED."
    m_Metadata:
      m_Items: []
  - m_Id: 71429693443
    m_Localized: "\xA1Genial! La tienda ya est\xE1 ordenada, as\xED que puedes abrirla
      ahora, toca la campanilla."
    m_Metadata:
      m_Items: []
  - m_Id: 71429693444
    m_Localized: Es hora de atender al primer cliente.
    m_Metadata:
      m_Items: []
  - m_Id: 71433887744
    m_Localized: "y haz clic en el signo de exclamaci\xF3n para saber qu\xE9 desea."
    m_Metadata:
      m_Items: []
  - m_Id: 71433887745
    m_Localized: "Y aseg\xFArate de finalizar la conversaci\xF3n cuando ya hayas
      entendido lo que te pide."
    m_Metadata:
      m_Items: []
  - m_Id: 71433887746
    m_Localized: "Puedes ver el historial para revisar qu\xE9 te solicit\xF3."
    m_Metadata:
      m_Items: []
  - m_Id: 71433887747
    m_Localized: "Tambi\xE9n ver\xE1s los libros prestados a un lado."
    m_Metadata:
      m_Items: []
  - m_Id: 71433887748
    m_Localized: De momento, ve y busca el libro para el cliente.
    m_Metadata:
      m_Items: []
  - m_Id: 71433887749
    m_Localized: "Mientras m\xE1s conozcas los libros, m\xE1s f\xE1cil ser\xE1 atender
      los pedidos de los clientes."
    m_Metadata:
      m_Items: []
  - m_Id: 1570702445158400
    m_Localized: "Y recibiras una propina en base a la atenci\xF3n que des, as\xED
      que esfuerzate. "
    m_Metadata:
      m_Items: []
  - m_Id: 3978396539985920
    m_Localized: "Esta es una librer\xEDa, no una discoteca. \xA1Ve a callarlos!"
    m_Metadata:
      m_Items: []
  - m_Id: 12667835218829312
    m_Localized: "\xA1Qu\xE9 desastre han hecho estos duendecillos!"
    m_Metadata:
      m_Items: []
  - m_Id: 12667915007074304
    m_Localized: "Deber\xE1s volver a poner todo en su lugar."
    m_Metadata:
      m_Items: []
  - m_Id: 12668754358607872
    m_Localized: "\xA1Suerte en tu primer d\xEDa!"
    m_Metadata:
      m_Items: []
  - m_Id: 17556834722947072
    m_Localized: "\xBFQuieres realizar el tutorial?"
    m_Metadata:
      m_Items: []
  references:
    version: 2
    RefIds: []
