  m_Script: {fileID: 11500000, guid: e9620f8c34305754d8cc9a7e49e852d9, type: 3}
  m_Name: CatDialogue_en-US
  m_EditorClassIdentifier: 
  m_LocaleId:
    m_Code: en-US
  m_SharedData: {fileID: 11400000, guid: 70715c09457dd1c4a92263855647757e, type: 2}
  m_Metadata:
    m_Items: []
  m_TableData:
  - m_Id: 22856965201920
    m_Localized: Hi! I'm Minino, your assistant in this magical library.
    m_Metadata:
      m_Items: []
  - m_Id: 23021344169984
    m_Localized: Every day, different creatures will come looking for books...
    m_Metadata:
      m_Items: []
  - m_Id: 23075161284608
    m_Localized: or requesting that you help them with certain tasks.
    m_Metadata:
      m_Items: []
  - m_Id: 23111186161664
    m_Localized: Follow the instructions to properly fulfill their orders.
    m_Metadata:
      m_Items: []
  - m_Id: 23153548632064
    m_Localized: But before receiving customers, you should clean this place a bit...
    m_Metadata:
      m_Items: []
  - m_Id: 23183865061376
    m_Localized: Good job yesterday!
    m_Metadata:
      m_Items: []
  - m_Id: 23218036056064
    m_Localized: "Today the customers will be a bit more demanding\u2014and so will
      I!"
    m_Metadata:
      m_Items: []
  - m_Id: 23266669010944
    m_Localized: You can't leave me hungry or without brushing me.
    m_Metadata:
      m_Items: []
  - m_Id: 23297421647872
    m_Localized: And you should water the plants, or Rhea will be sad when she comes
      back...
    m_Metadata:
      m_Items: []
  - m_Id: 23328451108864
    m_Localized: But otherwise, you're doing well! Keep it up!
    m_Metadata:
      m_Items: []
  - m_Id: 23374785585152
    m_Localized: Without a doubt, Rhea chose the right person to take care of this
      place.
    m_Metadata:
      m_Items: []
  - m_Id: 23405416587264
    m_Localized: So I think we could open the reading room starting today.
    m_Metadata:
      m_Items: []
  - m_Id: 23528523603968
    m_Localized: "Don't worry, you\u2019ll hardly notice it\u2019s open."
    m_Metadata:
      m_Items: []
  - m_Id: 23630805901312
    m_Localized: You're already quite the expert!
    m_Metadata:
      m_Items: []
  - m_Id: 23664247087104
    m_Localized: The customers might place more complex orders...
    m_Metadata:
      m_Items: []
  - m_Id: 23673839460352
    m_Localized: But trust your magical bookseller instinct!
    m_Metadata:
      m_Items: []
  - m_Id: 23704256552960
    m_Localized: Starting today, you will have access to the shop to buy items and
      decorate as you like.
    m_Metadata:
      m_Items: []
  - m_Id: 10497099322531840
    m_Localized: Wow, thanks to you the library is becoming well-known.
    m_Metadata:
      m_Items: []
  - m_Id: 10497099356086272
    m_Localized: The word is spreading that the service here is excellent.
    m_Metadata:
      m_Items: []
  - m_Id: 10497099356086273
    m_Localized: Maybe we could attract new customers...
    m_Metadata:
      m_Items: []
  - m_Id: 10497099356086274
    m_Localized: Though some unwelcome visitors might show up...
    m_Metadata:
      m_Items: []
  - m_Id: 10497099356086275
    m_Localized: Ah, don't worry about that. Let's start another day!
    m_Metadata:
      m_Items: []
  - m_Id: 16166956454027264
    m_Localized: You can check your task list to know what to do.
    m_Metadata:
      m_Items: []
  - m_Id: 16166956491776000
    m_Localized: Good luck!
    m_Metadata:
      m_Items: []
  - m_Id: 16166956491776001
    m_Localized: You can get there through the exit on your left.
    m_Metadata:
      m_Items: []
  - m_Id: 16166956491776002
    m_Localized: "And apart from that, have fun! You\u2019re doing great!"
    m_Metadata:
      m_Items: []
  references:
    version: 2
    RefIds: []
