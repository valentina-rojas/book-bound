  m_Name: HintsHechizos_en-US
  m_EditorClassIdentifier: 
  m_LocaleId:
    m_Code: en-US
  m_SharedData: {fileID: 11400000, guid: ffdf678cb2a3ab94e96750349361a141, type: 2}
  m_Metadata:
    m_Items: []
  m_TableData:
  - m_Id: 5704949760
    m_Localized: Arrange the runes in the correct order to activate the spell.
    m_Metadata:
      m_Items: []
  - m_Id: 32477192192
    m_Localized: Have you tried starting with the Earth rune?
    m_Metadata:
      m_Items: []
  - m_Id: 44732948480
    m_Localized: Shadow is quite stable... maybe it goes in the middle.
    m_Metadata:
      m_Items: []
  - m_Id: 56460222464
    m_Localized: Protection sounds like something that would pair with Fire, right?
    m_Metadata:
      m_Items: []
  - m_Id: 67864535040
    m_Localized: "Earth \u2192 Shadow \u2192 Fire might be a good combination..."
    m_Metadata:
      m_Items: []
  - m_Id: 9899251816112128
    m_Localized: "Look for the element that flows freely\u2026"
    m_Metadata:
      m_Items: []
  - m_Id: 9899251845472256
    m_Localized: Water comes first, maybe a blue rune?
    m_Metadata:
      m_Items: []
  - m_Id: 9899251845472257
    m_Localized: Now find the element that holds everything together.
    m_Metadata:
      m_Items: []
  - m_Id: 9899251845472258
    m_Localized: "The earth is solid\u2026 "
    m_Metadata:
      m_Items: []
  - m_Id: 9899251845472259
    m_Localized: "Finally, the element that burns\u2026 place the red rune."
    m_Metadata:
      m_Items: []
  - m_Id: 25350446311448576
    m_Localized: A gentle breeze might help...
    m_Metadata:
      m_Items: []
  - m_Id: 25350446328225792
    m_Localized: The one that illuminates everything may be the next...
    m_Metadata:
      m_Items: []
  - m_Id: 25350446328225793
    m_Localized: Only by flowing with lightness will you find the rune to complete
      the spell.
    m_Metadata:
      m_Items: []
  references:
    version: 2
    RefIds: []
