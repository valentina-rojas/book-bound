  m_TableData:
  - m_Id: 18589851648
    m_Localized: "\xBFQu\xE9 cosa es que cuanto m\xE1s intensa menos se ve?"
    m_Metadata:
      m_Items: []
  - m_Id: 767579299840
    m_Localized: La tormenta
    m_Metadata:
      m_Items: []
  - m_Id: 974777917440
    m_Localized: La noche
    m_Metadata:
      m_Items: []
  - m_Id: 987759288320
    m_Localized: La oscuridad
    m_Metadata:
      m_Items: []
  - m_Id: 1371806539776
    m_Localized: "\xBFC\xF3mo se llama la due\xF1a de la librer\xEDa?"
    m_Metadata:
      m_Items: []
  - m_Id: 1695883632640
    m_Localized: Astrid
    m_Metadata:
      m_Items: []
  - m_Id: 1714497953792
    m_Localized: Phoebe
    m_Metadata:
      m_Items: []
  - m_Id: 1725789020160
    m_Localized: Rhea
    m_Metadata:
      m_Items: []
  - m_Id: 1918928330752
    m_Localized: "\xBFQu\xE9 no es un ave, pero como ella vuela?"
    m_Metadata:
      m_Items: []
  - m_Id: 1931834204160
    m_Localized: Bruja
    m_Metadata:
      m_Items: []
  - m_Id: 1947122442240
    m_Localized: "Murci\xE9lago"
    m_Metadata:
      m_Items: []
  - m_Id: 1958228959232
    m_Localized: Escoba
    m_Metadata:
      m_Items: []
  - m_Id: 2877242908672
    m_Localized: "\xBFCu\xE1l es el nombre del gato?"
    m_Metadata:
      m_Items: []
  - m_Id: 2890320748544
    m_Localized: Salem
    m_Metadata:
      m_Items: []
  - m_Id: 2913787879424
    m_Localized: Minino
    m_Metadata:
      m_Items: []
  - m_Id: 2902375178240
    m_Localized: Artemis
    m_Metadata:
      m_Items: []
  - m_Id: 3267061522432
    m_Localized: "\xBFQu\xE9 libro contiene informaci\xF3n sobre hierbas y flores
      m\xE1gicas?"
    m_Metadata:
      m_Items: []
  - m_Id: 3279745097728
    m_Localized: Compendio de plantas susurrantes
    m_Metadata:
      m_Items: []
  - m_Id: 3292755828736
    m_Localized: Herbarium de sombras y lumbres
    m_Metadata:
      m_Items: []
  - m_Id: 3304961253376
    m_Localized: Hierbas y sabores de reinos olvidados
    m_Metadata:
      m_Items: []
  - m_Id: 10236841236799488
    m_Localized: "\xBFA qu\xE9 cliente le gusta asustar ni\xF1os?"
    m_Metadata:
      m_Items: []
  - m_Id: 10236841266159616
    m_Localized: Bruja
    m_Metadata:
      m_Items: []
  - m_Id: 10236841266159617
    m_Localized: Anciano
    m_Metadata:
      m_Items: []
  - m_Id: 10236841266159618
    m_Localized: Ogro
    m_Metadata:
      m_Items: []
  - m_Id: 10236841266159619
    m_Localized: "\xBFCu\xE1l fue el primer libro que te solicitaron?"
    m_Metadata:
      m_Items: []
  - m_Id: 10236841266159620
    m_Localized: No Mires Bajo la Cama
    m_Metadata:
      m_Items: []
  - m_Id: 10236841266159621
    m_Localized: La Dama de los Secretos Perdidos
    m_Metadata:
      m_Items: []
  - m_Id: 10236841266159622
    m_Localized: "El Guardi\xE1n del Bosque Azul"
    m_Metadata:
      m_Items: []
  - m_Id: 10236841266159623
    m_Localized: "\xBFCu\xE1ntas clasificaciones diferentes de libros existen en
      la biblioteca?"
    m_Metadata:
      m_Items: []
  - m_Id: 10236841266159624
    m_Localized: 6
    m_Metadata:
      m_Items: []
  - m_Id: 10236841266159625
    m_Localized: 7
    m_Metadata:
      m_Items: []
  - m_Id: 10236841266159626
    m_Localized: 8
    m_Metadata:
      m_Items: []
  - m_Id: 10236841266159627
    m_Localized: "\xBFCu\xE1ntas plantas tiene Rhea?"
    m_Metadata:
      m_Items: []
  - m_Id: 10236841266159628
    m_Localized: 5
    m_Metadata:
      m_Items: []
  - m_Id: 10236841266159629
    m_Localized: 6
    m_Metadata:
