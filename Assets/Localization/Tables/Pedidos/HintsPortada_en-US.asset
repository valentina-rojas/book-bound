  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: e9620f8c34305754d8cc9a7e49e852d9, type: 3}
  m_Name: HintsPortada_en-US
  m_EditorClassIdentifier: 
  m_LocaleId:
    m_Code: en-US
  m_SharedData: {fileID: 11400000, guid: fe0b7a3ca1207384b870d9d03d6d3bc9, type: 2}
  m_Metadata:
    m_Items: []
  m_TableData:
  - m_Id: 163331088384
    m_Localized: Think about the elements the author mentioned... what could go first?
    m_Metadata:
      m_Items: []
  - m_Id: 266649378816
    m_Localized: A map can be a good base...
    m_Metadata:
      m_Items: []
  - m_Id: 329786236928
    m_Localized: A compass can help with orientation... maybe near the map.
    m_Metadata:
      m_Items: []
  - m_Id: 375785168896
    m_Localized: Do you dare to hide something special among the mountains?
    m_Metadata:
      m_Items: []
  - m_Id: 423197581312
    m_Localized: Maybe a dragon peeking out...
    m_Metadata:
      m_Items: []
  - m_Id: 9867519041642496
    m_Localized: Do you see the sails on the horizon? The journey starts with the
      wind.
    m_Metadata:
      m_Items: []
  - m_Id: 9867519062614016
    m_Localized: "A secret island may be the center of the story\u2026 dare to draw
      it."
    m_Metadata:
      m_Items: []
  - m_Id: 9867519062614017
    m_Localized: The compass points strangely, maybe towards the hidden path.
    m_Metadata:
      m_Items: []
  - m_Id: 9867519062614018
    m_Localized: "Whispers tell of an ancient chest\u2026 could it be half-buried
      in the sand?"
    m_Metadata:
      m_Items: []
  - m_Id: 9867519062614019
    m_Localized: "Treasure is never just gold\u2026 leave a hint of mystery in the
      design."
    m_Metadata:
      m_Items: []
  - m_Id: 9912790203146240
    m_Localized: What elements were mentioned?
    m_Metadata:
      m_Items: []
  - m_Id: 9912790236700672
    m_Localized: "There are many constellations\u2026"
    m_Metadata:
      m_Items: []
  - m_Id: 9912790236700673
    m_Localized: "Do your best to meet the client\u2019s expectations."
    m_Metadata:
      m_Items: []
  references:
    version: 2
    RefIds: []
