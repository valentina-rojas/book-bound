  m_Script: {fileID: 11500000, guid: e9620f8c34305754d8cc9a7e49e852d9, type: 3}
  m_Name: HintsReparar_en-US
  m_EditorClassIdentifier: 
  m_LocaleId:
    m_Code: en-US
  m_SharedData: {fileID: 11400000, guid: e73f8710991d0c742a5265b33c9934ff, type: 2}
  m_Metadata:
    m_Items: []
  m_TableData:
  - m_Id: 22574440448
    m_Localized: "Before setting out, wouldn\u2019t it be useful to check the map?"
    m_Metadata:
      m_Items: []
  - m_Id: 22607994880
    m_Localized: The compass could show you the right path.
    m_Metadata:
      m_Items: []
  - m_Id: 22607994881
    m_Localized: "You can see monsters in the distance; don\u2019t lose track of
      the sequence of encounters."
    m_Metadata:
      m_Items: []
  - m_Id: 22607994882
    m_Localized: The target can be seen in the distance.
    m_Metadata:
      m_Items: []
  - m_Id: 22607994883
    m_Localized: "To open a treasure, you first need the key\u2026 have you found
      it yet?"
    m_Metadata:
      m_Items: []
  - m_Id: 388853991645184
    m_Localized: "Returning home isn\u2019t the start; make sure you\u2019ve completed
      everything before."
    m_Metadata:
      m_Items: []
  - m_Id: 388854025199616
    m_Localized: Do you have all the ingredients ready?
    m_Metadata:
      m_Items: []
  - m_Id: 388854025199617
    m_Localized: Time to mix everything well to make the dough.
    m_Metadata:
      m_Items: []
  - m_Id: 388854025199618
    m_Localized: "Let\u2019s knead until the dough is soft and smooth."
    m_Metadata:
      m_Items: []
  - m_Id: 388854025199619
    m_Localized: "The dough needs to rise\u2026 give it a little rest."
    m_Metadata:
      m_Items: []
  - m_Id: 15879494615867392
    m_Localized: "Don\u2019t eat them raw! Into the oven they go."
    m_Metadata:
      m_Items: []
  - m_Id: 15879494632644608
    m_Localized: For it to turn out well, you must mix all the ingredients.
    m_Metadata:
      m_Items: []
  - m_Id: 15879494632644609
    m_Localized: "Once it\u2019s finished, make sure to store it properly."
    m_Metadata:
      m_Items: []
  - m_Id: 15879494632644610
    m_Localized: Tea prepared with love mends hearts.
    m_Metadata:
      m_Items: []
  references:
    version: 2
    RefIds: []
